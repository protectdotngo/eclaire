---
import FilterBar from "./sections/calendar/FilterBar.astro";
import SelectedChips from "./sections/calendar/SelectedChips.astro";
import FilterPanel from "./sections/calendar/FilterPanel.astro";
import MonthNav from "./sections/calendar/MonthNav.astro";
import EventList from "./sections/calendar/EventList.astro";
---

<section class="calendar-page" x-data="calendarPage()" x-init="init()">
  <FilterBar />
  <SelectedChips />
  <FilterPanel />
  <MonthNav />
  <EventList />
</section>

<script>
  import Alpine from "alpinejs";
  import "flatpickr/dist/flatpickr.min.css";
  import { createCalendarComponent } from "../lib/calendarState";

  document.addEventListener("alpine:init", () => {
    Alpine.data("calendarPage", createCalendarComponent);
  });
</script>

<style>
  .calendar-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 2rem 3rem;
    position: relative;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .calendar-page {
      padding: 1rem;
    }
  }
</style>
