---
import { getEntry } from "astro:content";

interface Props {
  id: string;
}

const { id } = Astro.props;
const partner = await getEntry("partners", id);
---

{
  partner && (
    <a
      class="v1-resource-card-badge"
      href={partner.data.url}
      target="_blank"
      set:html={partner.data.name}
    />
  )
}

<style>
  .v1-resource-card-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.75rem;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 81.13%);
    color: white;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .v1-resource-card-badge:hover {
    filter: brightness(0.92);
    text-decoration: underline;
    cursor: alias;
  }

  .v1-resource-card-badge :global(sup) {
    font-size: 0.7em;
  }
</style>
