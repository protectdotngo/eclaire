---
import { getCollection } from "astro:content";
import Partner from "./sections/Partner.astro";
import Hero from "../sections/general/Hero.astro";
import Background from "../sections/general/Background.astro";
import EclaireInfo from "../../assets/eclaire-2-info.svg";
import Image from "astro/components/Image.astro";

const visiblePartners = (
  await getCollection("partners", (p) => !p.data.hidden)
).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<section class="v1-home">
  <Hero
    title="Le numérique évolue vite et…<br />il n'est pas toujours simple de suivre !"
    lead=""
    body="À travers ce projet, nous souhaitons poursuivre les avancées de la phase pilote du projet éclaire en faveur de la coopération entre les partenaires issus des milieux associatif et institutionnel, afin d'assurer un accompagnement plus cohérent et efficace de la population."
    image="/images/4.jpg"
  />

  <section class="v1-video-section">
    <div class="v1-hero-video">
      <iframe
        src="https://www.youtube.com/embed/ipfqEjH04ag"
        title="Présentation du projet Éclaire"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  </section>

  <section class="v1-qui">
    <Background />
    <div class="v1-qui-text">
      <h2 class="v1-qui-title">
        Avec éclaire, nous apportons des réponses concrètes là où vous en avez
        besoin.
      </h2>
      <p>
        Dans le canton de Genève, éclaire mobilise une communauté associative
        engagée pour l'inclusion et la sécurité numérique, au plus proche de
        celles et ceux qui en ont besoin.
      </p>
    </div>

    <div class="v1-collage">
      <div class="ai-info-collage-imgs">
        <div class="collage-img-frame collage-img-1">
          <img src="/images/geneva.jpg" alt="" />
        </div>
        <div class="collage-img-frame collage-img-2">
          <img src="/images/1.jpg" alt="" />
        </div>
        <div class="collage-img-frame collage-img-3">
          <img src="/images/un.jpg" alt="" />
        </div>
        <div class="ai-info-collage-card">
          <Image src={EclaireInfo} class={"ai-info-collage-logo"} alt={""} />
        </div>
      </div>
    </div>
  </section>

  <section class="v1-partners" id="partenaires">
    <h2 class="v1-partners-title">La communauté éclaire</h2>
    <div class="v1-partner-list">
      {visiblePartners.map((partner) => <Partner partner={partner} />)}
    </div>
  </section>
</section>

<style>
  .v1-home {
    position: relative;
    z-index: 0;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .v1-video-section {
    display: flex;
    justify-content: center;
    padding: 2rem;
    margin: 2rem 0 4rem;
  }

  .v1-hero-video {
    width: 100%;
    max-width: 620px;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 28px rgba(var(--color-main-3), 0.25);
  }

  .v1-hero-video iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .v1-qui {
    position: relative;
    max-width: 1200px;
    margin: 0 auto 5rem;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: center;
    box-sizing: border-box;
  }

  .v1-qui-title {
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 1.25rem;
    color: transparent;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 81.13%);
    background-clip: text;
  }

  .v1-qui-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: #374151;
    margin: 0;
  }

  .v1-collage {
    position: relative;
    height: 380px;
  }

  .ai-info-collage-imgs {
    position: relative;
    width: 100%;
    height: 100%;
    margin: auto;
  }

  .collage-img-frame {
    position: absolute;
    overflow: hidden;
    display: block;
    min-width: 150px;
    border-radius: 10px;
    background-color: rgba(var(--color-main-2), 0.08);
    transform: rotate(-15deg) skewX(-15deg);
  }

  .collage-img-frame img {
    width: 120%;
    height: 130%;
    object-fit: cover;
    display: block;
    transform: skewX(15deg) scale(1.2) rotate(15deg) translateY(-5px);
  }

  .collage-img-2 {
    width: 75%;
    height: 80%;
    max-width: 500px;
    left: 60%;
    top: -5%;
    transform: translateX(-50%) rotate(-15deg) skewX(-15deg);
  }

  .collage-img-2 img {
    transform: skewX(15deg) scale(1.2) rotate(15deg) translateY(-10px);
  }

  .collage-img-1 {
    width: 40%;
    height: 50%;
    max-width: 300px;
    left: -5%;
    top: 35%;
    z-index: 1;
  }

  .collage-img-1 img {
    transform: skewX(15deg) scale(1.2) rotate(15deg) translateY(-5px)
      translateX(-20px);
  }

  .collage-img-3 {
    width: 30%;
    height: 40%;
    max-width: 300px;
    right: -5%;
    top: 20%;
    z-index: 1;
  }

  .ai-info-collage-card {
    position: absolute;
    left: 65%;
    bottom: -15%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    align-items: end;
    gap: 0.75rem;
    background-color: transparent;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border-radius: 12px;
    max-width: 100%;
  }

  .ai-info-collage-logo {
    width: auto;
    height: 140px;
    flex-shrink: 0;
  }

  .ai-info-collage-caption {
    font-size: 0.75rem;
    font-weight: 700;
    color: #1f2937;
    line-height: 1.3;
    padding-bottom: 8px;
    width: 100px;
  }

  .v1-partners {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    scroll-margin-top: 5rem;
    box-sizing: border-box;
  }

  .v1-partners-title {
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
    color: transparent;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 26.13%);
    background-clip: text;
  }

  .v1-partner-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .v1-qui {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .v1-collage {
      height: 340px;
      width: 70%;
      margin: 2rem auto;
    }
  }

  @media (max-width: 650px) {
    .v1-qui,
    .v1-partners {
      padding: 0 1rem;
    }
    .v1-qui-title {
      font-size: 1.5rem;
    }
    .v1-video-section {
      padding: 1rem;
    }
  }
</style>
