---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Partner from "./sections/Partner.astro";
import Hero from "../sections/general/Hero.tsx";
import Background from "../sections/general/Background.tsx";
import LogoProtectDotNgo from "../../assets/images/logo-protectdotngo.svg";
import LogoVilleDeGeneve from "../../assets/images/logo-gva.svg";
import LogoCantonDeGeneve from "../../assets/images/logo-canton.png";
import LogoMIA from "../../assets/images/logo-mia.png";

const visiblePartners = (
  await getCollection("partners", (p) => !p.data.hidden)
).sort((a, b) => a.data.name.localeCompare(b.data.name));

type Partner = {
  name: string;
  link: string;
  image: ImageMetadata;
};

const logos: Partner[] = [
  {
    name: "Ville de Genève",
    link: "https://www.geneve.ch",
    image: LogoVilleDeGeneve,
  },
  {
    name: "Canton de Genève",
    link: "https://ge.ch",
    image: LogoCantonDeGeneve,
  },
  {
    name: "Maison Internationale des Associations",
    link: "https://mia-ge.ch/",
    image: LogoMIA,
  },
  {
    name: "Protect<sup>.ngo</sup>",
    link: "https://protect.ngo",
    image: LogoProtectDotNgo,
  },
];
---

<section class="v1-home">
  <Hero
    title="Le numérique évolue vite et…<br />il n'est pas toujours simple de suivre !"
    lead=""
    body="À travers ce projet, nous souhaitons poursuivre les avancées de la phase pilote du projet éclaire en faveur de la coopération entre les partenaires issus des milieux associatif et institutionnel, afin d'assurer un accompagnement plus cohérent et efficace de la population."
    image="/images/4.jpg"
  />

  <section class="v1-video-section">
    <div class="v1-hero-video">
      <iframe
        src="https://www.youtube.com/embed/ipfqEjH04ag"
        title="Présentation du projet éclaire"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  </section>

  <section class="v1-qui">
    <Background />
    <div class="v1-qui-text">
      <h2 class="v1-qui-title">
        Avec éclaire, nous apportons des réponses concrètes là où vous en avez
        besoin.
      </h2>
      <p>
        Dans le canton de Genève, éclaire mobilise une communauté associative
        engagée pour l'inclusion et la sécurité numérique, au plus proche de
        celles et ceux qui en ont besoin.
      </p>
    </div>

    <div class="v1-collage">
      <img src={"/images/collage2.png"} alt={""} class="v1-collage-img" />
    </div>
  </section>

  <section class="v1-partners" id="partenaires">
    <h2 class="v1-partners-title">Les partenaires éclaire</h2>
    <div class="partners">
      {
        logos.map((l) => (
          <a href={l.link}>
            <Image class="logo" src={l.image} alt={`Logo de ${l.name}`} />
          </a>
        ))
      }
    </div>
  </section>

  <section class="v1-partners" id="partenaires">
    <h2 class="v1-partners-title">La communauté éclaire</h2>
    <div class="v1-partner-list">
      {visiblePartners.map((partner) => <Partner partner={partner} />)}
    </div>
  </section>
</section>

<style>
  .v1-home {
    position: relative;
    z-index: 0;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .v1-video-section {
    display: flex;
    justify-content: center;
    padding: 2rem;
    margin: 2rem 0 4rem;
  }

  .v1-hero-video {
    width: 100%;
    max-width: 620px;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 28px rgba(var(--color-main-3), 0.25);
  }

  .v1-hero-video iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .v1-qui {
    position: relative;
    max-width: 1200px;
    margin: 0 auto 5rem;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: center;
    box-sizing: border-box;
  }

  .v1-qui-title {
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 1.25rem;
    color: transparent;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 81.13%);
    background-clip: text;
  }

  .v1-qui-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: #374151;
    margin: 0;
  }

  .v1-collage {
    position: relative;
    max-width: 500px;
  }

  .v1-collage-img {
    width: 100%;
  }

  .v1-partners {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    scroll-margin-top: 5rem;
    box-sizing: border-box;
  }

  .v1-partners-title {
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
    color: transparent;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 26.13%);
    background-clip: text;
  }

  .v1-partner-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .partners {
    display: grid;
    grid-auto-rows: 1fr;
    align-items: center;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-block-end: 4rem;

    .logo {
      max-width: 60%;
      height: auto;
    }

    @media (min-width: 800px) {
      grid-template-columns: repeat(4, 1fr);
      gap: 4rem;

      .logo {
        max-width: 100%;
        height: auto;
      }
    }
  }

  @media (max-width: 900px) {
    .v1-qui {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .v1-qui-title {
      width: 70%;
    }
    .v1-collage {
      width: 70%;
      margin: -2rem auto 0 auto;
    }
  }

  @media (max-width: 650px) {
    .v1-qui,
    .v1-partners {
      padding: 0 1rem;
    }
    .v1-qui-title {
      font-size: 1.5rem;
      width: 100%;
    }
    .v1-video-section {
      padding: 1rem;
    }
  }
</style>
