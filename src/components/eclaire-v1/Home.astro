---
import { getCollection } from "astro:content";
import Partner from "./sections/Partner.astro";

const visiblePartners = (
  await getCollection("partners", (p) => !p.data.hidden)
).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<section class="v1-home">
  <header class="v1-hero">
    <h1 class="v1-hero-title">
      LE NUMÉRIQUE ÉVOLUE VITE ET…<br />
      IL N'EST PAS TOUJOURS SIMPLE DE SUIVRE !
    </h1>

    <div class="v1-hero-content">
      <p class="v1-hero-intro">
        À travers ce projet, nous souhaitons poursuivre les avancées de la phase
        pilote du projet éclaire en faveur de la coopération entre les
        partenaires issus des milieux associatif et institutionnel, afin
        d'assurer un accompagnement plus cohérent et efficace de la population.
      </p>
      <div class="v1-hero-video">
        <iframe
          src="https://www.youtube.com/embed/ipfqEjH04ag"
          title="Présentation du projet Éclaire"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    </div>

    <h2 class="v1-hero-tagline">
      AVEC ÉCLAIRE, NOUS APPORTONS DES<br />
      <span class="v1-hero-tagline-accent">RÉPONSES CONCRÈTES</span> LÀ OÙ VOUS EN
      AVEZ BESOIN.
    </h2>
  </header>

  <section class="v1-qui">
    <div class="v1-qui-text">
      <h2>Qui sommes-nous ?</h2>
      <p>
        Dans le canton de Genève, éclaire mobilise une communauté associative
        engagée pour l'inclusion et la sécurité numérique, au plus proche de
        celles et ceux qui en ont besoin.
      </p>
    </div>
    <div class="v1-qui-image">
      <img
        src="/eclaire-v1/geneva.jpg"
        alt="Vue de Genève avec le Jet d'Eau"
        loading="lazy"
      />
    </div>
  </section>

  <section class="v1-partners" id="partenaires">
    <h2 class="v1-partners-title">La communauté éclaire</h2>
    <div class="v1-partner-list">
      {visiblePartners.map((partner) => <Partner partner={partner} />)}
    </div>
  </section>
</section>

<style>
  .v1-home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
    position: relative;
    z-index: 0;
  }

  .v1-home::before {
    content: "";
    position: fixed;
    inset: 0 -5rem;
    z-index: -1;
    pointer-events: none;
    background-image:
      url("/decorations/protect3.svg"), url("/decorations/protect2.svg");
    background-repeat: repeat-y, repeat-y;
    background-position:
      right -2rem top 100px,
      left -4rem top 400px;
    background-size:
      auto 1000px,
      auto 1000px;
  }

  .v1-home > * {
    position: relative;
    z-index: 1;
  }

  .v1-hero {
    margin-bottom: 4rem;
  }

  .v1-hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 2.5rem;
    color: #1f2937;
    letter-spacing: -0.01em;
  }

  .v1-hero-content {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .v1-hero-intro {
    font-size: 1rem;
    line-height: 1.7;
    color: #374151;
    margin: 0;
  }

  .v1-hero-video {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .v1-hero-video iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .v1-hero-tagline {
    font-size: 2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #1f2937;
    line-height: 1.45;
    margin: 0;
  }

  .v1-hero-tagline-accent {
    color: #34719d;
    border-bottom: 3px solid #34719d;
    padding-bottom: 0.1rem;
    text-wrap: nowrap;
  }

  .v1-qui {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .v1-qui-text {
    background: #ebe9e8;
    padding: 2.5rem;
    border-radius: 12px;
  }

  .v1-qui-text h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 1rem;
    color: #1f2937;
  }

  .v1-qui-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: #374151;
    margin: 0;
  }

  .v1-qui-image {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .v1-qui-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .v1-partners {
    margin-bottom: 2rem;
    scroll-margin-top: 5rem;
  }

  .v1-partners-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 1.5rem;
    color: #1f2937;
  }

  .v1-partner-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .v1-home {
      padding: 1.5rem 1rem 3rem;
    }

    .v1-hero-title {
      font-size: 1.7rem;
    }

    .v1-hero-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .v1-hero-tagline {
      font-size: 1.1rem;
    }

    .v1-qui {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .v1-qui-text {
      padding: 1.5rem;
    }
  }
</style>
