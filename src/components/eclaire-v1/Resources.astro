---
import { getCollection } from "astro:content";
import ResourcesIsland from "./ResourcesIsland.tsx";
import type {
  PartnerOption,
  ResourceDTO,
} from "./sections/resourcesContext.ts";

// Coquille SSR : elle lit les content collections et aplatit tout en props
// serialisables. Une `CollectionEntry` ne peut pas traverser la frontiere
// d'ile — le `<Content />` de `render()` est un composant Astro, ni
// serialisable ni rendable par Solid.
//
// On reutilise `rendered.html`, le HTML que le content layer d'Astro a deja
// produit avec sa propre chaine remark : c'est exactement ce que rend
// `<Content />`. Passer par `marked` a la place produisait un HTML different
// (remark applique smartypants, donc ' -> ’, la ou marked echappe en &#39;).
//
// Le lien `reference("partners")` est resolu via une seule Map, au lieu d'un
// `getEntry` par carte comme le faisait ResourcePartner.astro.
const partners = await getCollection("partners");
const partnerById = new Map(partners.map((p) => [p.id, p]));

const resources = (await getCollection("resources")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const resourceDtos: ResourceDTO[] = resources.map((resource) => {
  const partner = partnerById.get(resource.data.partner.id);
  return {
    id: resource.id,
    name: resource.data.name,
    url: resource.data.url,
    partnerId: resource.data.partner.id,
    partnerName: partner?.data.name ?? "",
    partnerUrl: partner?.data.url ?? "",
    bodyHtml: resource.rendered?.html ?? "",
  };
});

const partnersWithResources = new Set(resources.map((r) => r.data.partner.id));
const partnerOptions: PartnerOption[] = partners
  .filter((p) => partnersWithResources.has(p.id))
  .map((p) => ({ id: p.id, name: p.data.name }));
---

<ResourcesIsland
  resources={resourceDtos}
  partners={partnerOptions}
  client:load
/>
