---
import { getCollection } from "astro:content";
import ResourcesIsland from "./ResourcesIsland.tsx";
import type {
  PartnerOption,
  ResourceDTO,
} from "./sections/resourcesContext.ts";

// SSR shell: it reads the content collections and flattens everything into
// serialisable props. A `CollectionEntry` cannot cross the island boundary —
// the `<Content />` returned by `render()` is an Astro component, neither
// serialisable nor renderable by Solid.
//
// We reuse `rendered.html`, the HTML Astro's content layer already produced
// with its own remark pipeline: that is exactly what `<Content />` renders.
// Going through `marked` instead produced different HTML (remark applies
// smartypants, so ' -> ’, where marked escapes to &#39;).
//
// The `reference("partners")` link is resolved through a single Map, instead of
// one `getEntry` per card as ResourcePartner.astro used to do.
const partners = await getCollection("partners");
const partnerById = new Map(partners.map((p) => [p.id, p]));

const resources = (await getCollection("resources")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const resourceDtos: ResourceDTO[] = resources.map((resource) => {
  const partner = partnerById.get(resource.data.partner.id);
  return {
    id: resource.id,
    name: resource.data.name,
    url: resource.data.url,
    partnerId: resource.data.partner.id,
    partnerName: partner?.data.name ?? "",
    partnerUrl: partner?.data.url ?? "",
    bodyHtml: resource.rendered?.html ?? "",
  };
});

const partnersWithResources = new Set(resources.map((r) => r.data.partner.id));
const partnerOptions: PartnerOption[] = partners
  .filter((p) => partnersWithResources.has(p.id))
  .map((p) => ({ id: p.id, name: p.data.name }));
---

<ResourcesIsland
  resources={resourceDtos}
  partners={partnerOptions}
  client:load
/>
