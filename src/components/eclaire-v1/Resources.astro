---
import { getCollection } from "astro:content";
import Resource from "./sections/Resource.astro";
import ChevronSVG from "../../assets/chevron-down.svg";

const partners = await getCollection("partners");
const resources = (await getCollection("resources")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const partnersWithResources = Array.from(
  new Set(resources.map((r) => r.data.partner.id)),
);
---

<section class="v1-resources" x-data="resourcesPage()">
  <header class="v1-resources-hero">
    <h1 class="v1-resources-title">
      BESOIN D'AIDE ?<br />
      LAISSEZ-VOUS ÉCLAIRER PAR NOS <span class="v1-resources-title-accent"
        >RESSOURCES UTILES</span
      >
    </h1>
  </header>

  <div class="v1-resources-filter">
    <label for="partner-filter" class="v1-resources-filter-label">
      Filtrer par partenaire
    </label>
    <div class="v1-resources-filter-wrap">
      <select
        id="partner-filter"
        class="v1-resources-filter-select"
        x-model="selectedPartner"
      >
        <option value="">Toutes les ressources</option>
        {
          partners
            .filter((p) => partnersWithResources.includes(p.id))
            .map((partner) => (
              <option value={partner.id} set:html={partner.data.name} />
            ))
        }
      </select>
      <span class="v1-resources-filter-chevron">
        <ChevronSVG />
      </span>
    </div>
  </div>

  <div class="v1-resources-grid">
    {resources.map((resource) => <Resource resource={resource} />)}
  </div>

  <div
    class="v1-resources-empty"
    x-show="filteredCount === 0"
    x-transition.opacity.duration.200ms
  >
    Aucune ressource ne correspond à ce filtre.
  </div>
</section>

<script>
  import Alpine from "alpinejs";

  document.addEventListener("alpine:init", () => {
    Alpine.data("resourcesPage", () => ({
      selectedPartner: "",

      get filteredCount() {
        const cards = document.querySelectorAll(
          ".v1-resource-card[data-partner]",
        );
        if (this.selectedPartner === "") return cards.length;
        let count = 0;
        cards.forEach((card) => {
          if (card.getAttribute("data-partner") === this.selectedPartner) {
            count++;
          }
        });
        return count;
      },
    }));
  });
</script>

<style>
  .v1-resources {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
    position: relative;
    z-index: 0;
  }

  .v1-resources::before {
    content: "";
    position: fixed;
    inset: 0 -5rem;
    z-index: -1;
    pointer-events: none;
    background-image:
      url("/decorations/protect3.svg"), url("/decorations/protect2.svg");
    background-repeat: repeat-y, repeat-y;
    background-position:
      right -2rem top 100px,
      left -4rem top 400px;
    background-size:
      auto 1000px,
      auto 1000px;
  }

  .v1-resources > * {
    position: relative;
    z-index: 1;
  }

  .v1-resources-hero {
    margin-bottom: 2.5rem;
  }

  .v1-resources-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
    color: #1f2937;
    letter-spacing: -0.01em;
  }

  .v1-resources-title-accent {
    color: #34719d;
    border-bottom: 3px solid #34719d;
    padding-bottom: 0.1rem;
  }

  .v1-resources-filter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
    max-width: 320px;
  }

  .v1-resources-filter-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .v1-resources-filter-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .v1-resources-filter-select {
    width: 100%;
    padding: 0.6rem 2.5rem 0.6rem 0.9rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background-color: white;
    appearance: none;
    -webkit-appearance: none;
    font-size: 0.95rem;
    color: #1f2937;
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .v1-resources-filter-select:focus {
    outline: none;
    border-color: #2b4888;
    box-shadow: 0 0 0 3px rgba(43, 72, 136, 0.12);
  }

  .v1-resources-filter-chevron {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: #2b4888;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .v1-resources-grid {
    column-count: 2;
    column-gap: 1rem;
  }

  .v1-resources-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: #6b7280;
    background: white;
    border: 1px dashed #d1d5db;
    border-radius: 10px;
  }

  @media (max-width: 768px) {
    .v1-resources {
      padding: 1.5rem 1rem 3rem;
    }

    .v1-resources-title {
      font-size: 1.5rem;
    }

    .v1-resources-grid {
      column-count: 1;
    }
  }
</style>
