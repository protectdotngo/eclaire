<section>
  <div id="mapSection" class="mapSection"></div>
</section>
<script>
  import { $mapData } from "../lib/mapStore";
  import L from "leaflet";
  import "leaflet.markercluster";
  import "leaflet/dist/leaflet.css";
  import "leaflet.markercluster/dist/MarkerCluster.css";
  import "leaflet.markercluster/dist/MarkerCluster.Default.css";
  import type { OrgWithChatContext } from "../interfaces/org";
  import MailSvgRaw from "../assets/images/mail.svg?raw";
  import PhoneSvgRaw from "../assets/images/phone.svg?raw";

  delete (L.Icon.Default.prototype as any)._getIconUrl;

  L.Icon.Default.mergeOptions({
    iconUrl: "/leaflet/marker-icon.png",
    iconRetinaUrl: "/leaflet/marker-icon-2x.png",
    shadowUrl: "/leaflet/marker-shadow.png",
  });

  var customIcon = L.icon({
    iconUrl: "/leaflet/Pin.svg",
    shadowUrl: "/leaflet/marker-shadow.png",
    iconSize: [24, 30],
    iconAnchor: [12, 30],
    shadowSize: [29, 29],
    shadowAnchor: [9, 29],
    popupAnchor: [0, -27],
  });

  function escapeHtml(s: string): string {
    if (!s) return "";
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function formatContactHref(contact: string): string {
    const trimmed = contact.trim();
    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed)) {
      return `mailto:${trimmed}`;
    }
    const digitsOnly = trimmed.replace(/[\s().-]/g, "");
    if (/^\+?\d{7,15}$/.test(digitsOnly)) {
      return `tel:${digitsOnly}`;
    }
    return trimmed;
  }

  function getContactType(contact: string): "email" | "phone" | "other" {
    const trimmed = contact.trim();
    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed)) return "email";
    const digitsOnly = trimmed.replace(/[\s().-]/g, "");
    if (/^\+?\d{7,15}$/.test(digitsOnly)) return "phone";
    return "other";
  }

  function renderContacts(contacts: string[] | undefined | null): string {
    if (!contacts || contacts.length === 0) return "";
    const items = contacts
      .map((c) => {
        const type = getContactType(c);
        const href = formatContactHref(c);
        const icon =
          type === "email" ? MailSvgRaw : type === "phone" ? PhoneSvgRaw : "";
        return `<a class="popup-contact-link" href="${escapeHtml(href)}">${icon}<span>${escapeHtml(c)}</span></a>`;
      })
      .join("");
    return `<div class="popup-contact-row">${items}</div>`;
  }

  const map = L.map("mapSection").setView([46.2044, 6.1432], 12);
  map.removeControl(map.attributionControl);
  L.control
    .attribution({ prefix: '<a href="https://leafletjs.com/">Leaflet</a>' })
    .addTo(map);
  const Stadia_OSMBright = L.tileLayer(
    "https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}{r}.{ext}",
    {
      minZoom: 12,
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.stadiamaps.com/" target="_blank">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    },
  );
  const CartoDB_Voyager = L.tileLayer(
    "https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_3001_1_b4a3f1de346ee21982c92500",
    {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: "abcd",
      minZoom: 5,
      maxZoom: 20,
    },
  );

  CartoDB_Voyager.addTo(map);

  map.zoomControl.setPosition("bottomleft");

  const markers = L.markerClusterGroup();
  const markersList = new Map<string, L.Marker>();

  async function fillMap(marks: readonly OrgWithChatContext[]) {
    if (marks.length === 0) return;
    markers.clearLayers();
    markersList.clear();
    const pinIcon = customIcon;
    for (const item of marks) {
      if (typeof item.lat !== "number" || typeof item.lon !== "number") {
        continue;
      }
      const marker = L.marker([item.lat, item.lon], { icon: pinIcon });
      marker.bindPopup(
        `<a class="popup-link" target="_blank" href="${escapeHtml(item.domain ?? "")}">
          <h3 class="popup-title">${escapeHtml(item.name)}</h3>
        </a>
        <a class="popup-link" target="_blank" href="https://www.google.com/maps?q=${item.lat},${item.lon}">
          <p class="popup-address">${escapeHtml(item.address ?? "")}</p>
        </a>
        ${renderContacts(item.contact)}`,
      );
      markers.addLayer(marker);
      markersList.set(item.id, marker);
    }
    map.addLayer(markers);
    if (markers.getLayers().length > 0) {
      const bounds = markers.getBounds();
      map.fitBounds(bounds, { maxZoom: 16 });
    }
  }

  map.addLayer(markers);

  $mapData.subscribe((marks) => {
    if (marks) fillMap(marks);
  });

  const sideBar = document.getElementById("sideBar");
  sideBar?.addEventListener("transitionend", (e) => {
    if (e.propertyName === "max-width") {
      map.invalidateSize();
    }
  });

  window.addEventListener("map-focus-org", (e: Event) => {
    const org = (e as CustomEvent).detail;
    if (!org || typeof org.lat !== "number" || typeof org.lon !== "number")
      return;

    if (window.innerWidth <= 1000) {
      document.querySelector(".side-bar")?.classList.add("collapsed");
      document.body.classList.add("chat-panel-collapsed");
    }

    setTimeout(
      () => {
        const marker = markersList.get(org.id);
        if (!marker) return;
        map.flyTo([org.lat, org.lon], 17, {
          duration: 0.75,
          easeLinearity: 0.5,
        });
        map.once("moveend", () => {
          marker.openPopup();
        });
      },
      window.innerWidth <= 1000 ? 320 : 0,
    );
  });
</script>
<style>
  .mapSection {
    height: 100vh;
  }
</style>
<style is:global>
  .popup-link {
    text-decoration: none;
    display: block;
  }
  .popup-title {
    font-size: 1.2rem;
    margin: 0 0 0.2rem;
    color: black;
    transition: color 0.2s ease;
    text-align: left;
    font-weight: 600;
  }
  .popup-title:hover {
    color: rgba(var(--color-main-2-dark), 1);
  }
  .popup-desc {
    font-size: 0.9rem;
    color: #1f2937;
    margin: 0 0 0.2rem;
    white-space: wrap;
  }
  .popup-address {
    font-size: 0.9rem;
    color: #6b7280;
    margin: 0 0 0.2rem;
    font-style: italic;
    transition: color 0.2s ease;
  }
  .popup-address:hover {
    color: black;
  }
  .popup-address::first-letter {
    text-transform: capitalize;
  }
  .popup-contact-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0 0 0.2rem;
  }

  .popup-contact-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.95rem;
    color: rgba(var(--color-main-2), 1) !important;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .popup-contact-link:hover {
    color: rgba(var(--color-main-2-dark), 1) !important;
  }

  .popup-contact-link:visited {
    color: rgba(var(--color-main-2), 1) !important;
  }

  .popup-contact-link svg {
    flex-shrink: 0;
  }

  .marker-cluster-small {
    background-color: rgba(var(--color-main-2), 0.25) !important;
  }
  .marker-cluster-medium {
    background-color: rgba(var(--color-main), 0.25) !important;
  }
  .marker-cluster-large {
    background-color: rgba(var(--color-main-3), 0.25) !important;
  }
  .marker-cluster-small div {
    background-color: rgba(var(--color-main-2), 1) !important;
    color: white;
    font-weight: 600 !important;
  }
  .marker-cluster-medium div {
    background-color: rgba(var(--color-main), 1) !important;
    color: white;
    font-weight: 600 !important;
  }
  .marker-cluster-large div {
    background-color: rgba(var(--color-main-3), 1) !important;
    color: white;
    font-weight: 600 !important;
  }
</style>
