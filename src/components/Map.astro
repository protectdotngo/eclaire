---
import "leaflet/dist/leaflet.css";
import "leaflet.markercluster/dist/MarkerCluster.css";
import "leaflet.markercluster/dist/MarkerCluster.Default.css";
---

<section>
  <div id="mapSection" style="height: 100vh;"></div>
</section>
<script>
  import { $mapData } from "../lib/mapStore";
  import { $filterStore } from "../lib/filterStore";
  import L from "leaflet";
  import "leaflet.markercluster/dist/leaflet.markercluster-src.js";

  var map = L.map("mapSection").setView([46.2044, 6.1432], 12);
  var Stadia_OSMBright = L.tileLayer(
    "https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}{r}.{ext}",
    {
      minZoom: 12,
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.stadiamaps.com/" target="_blank">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      ext: "png",
    },
  );
  var CartoDB_Voyager = L.tileLayer(
    "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
    {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: "abcd",
      minZoom: 12,
      maxZoom: 20,
    },
  );

  CartoDB_Voyager.addTo(map);

  map.zoomControl.setPosition("bottomleft");

  var markers = L.markerClusterGroup();

  function fillMap(marks) {
    if (marks) {
      markers.clearLayers();
      for (const item of marks) {
        markers.addLayer(
          L.marker([item.lat, item.lon]).bindPopup(
            '<a style="text-decoration:none; color:black;" target="_blank" href="' +
              item.website +
              '"><h3>' +
              item.name +
              "</h3><p>" +
              item.address +
              "</p>",
          ),
        );
      }
      map.addLayer(markers);
      map.fitBounds(markers.getBounds(), {
        maxZoom: 15,
      });
    }
  }

  map.addLayer(markers);

  $mapData.subscribe((marks) => fillMap(marks));
  $filterStore.subscribe((marks) => fillMap(marks));
</script>
<style>
  #map {
    height: 100vh;
  }
</style>
