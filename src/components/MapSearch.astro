---
import FilterSVG from "../assets/filter.svg";
import ChatSVG from "../assets/chat.svg";
import LinkSVG from "../assets/link.svg";
import XSVG from "../assets/cross.svg";
---

<section class="map-search">
  <div class="ai" id="ai">
    <div class="ai-info">
      <h2 class="ai-info-title" id="infoTitle">
        Avec Éclaire, nous apportons des <span class="ai-info-title-highlight"
          >réponses concrètes</span
        > aux problèmes numériques, là où vous en avez besoin.
      </h2>
    </div>
    <div class="ai-response-cont">
      <div
        class="ai-response"
        id="ai-response"
        x-data="streamingResults()"
        x-init="init()"
        @search-finished.window="startStreaming($event.detail)"
      >
        <template x-for="(item, i) in displayed" :key="item.domain">
          <div class="ai-reponse-element">
            <h3 x-text="item.displayName"></h3>
            
            <template x-if="item.desc">
              <p x-data="{ expanded: false }">
                <span x-text="expanded ? item.displayDesc : $truncate(item.displayDesc, { words: count })"></span>
                <span class="cursor" x-show="item.streaming">▊</span>
                
                <template x-if="!item.streaming">
                  <span>
                    <span class="underline pointer" x-show="!expanded" @click="expanded = !expanded">Lire plus</span>
                    <span class="underline pointer" x-show="expanded" @click="expanded = !expanded">Réduire</span>
                  </span>
                </template>
              </p>
            </template>
            <template x-if="item.domain">
              <div class="ai-response-btn-cont" x-show="!item.streaming" x-transition.opacity.duration.400ms>
                <a :href="item.domain" target="_blank" class="ai-response-btn">
                  Visiter le site <LinkSVG />
                </a>
              </div>
            </template>
            
            <template x-if="i < displayed.length - 1">
              <hr class="ai-response-separator" />
            </template>
          </div>
        </template>
      </div>
    </div>
    <form
      class="ai-search"
      id="aiForm"
      onkeydown="if(event.keyCode === 13){document.getElementById('aiFormSubmit').click(); return false}"
    >
      <div class="ai-search-cont">
        <input
          type="text"
          class="ai-search-bar"
          id="search-bar"
          name="search"
          value=""
          placeholder="Poser une question"
        />
        <XSVG id={"clear-search"} class={"none"} />
        <button type="button" class="ai-search-btn" id="aiFormSubmit"
          >Envoyer</button
        >
      </div>
    </form>
    <div class="ai-swap swap">
      <FilterSVG width={"23"} height={"27"} fill={"#34939D"} />
      <span class="ai-swap-link"> ou afficher les filtres </span>
    </div>
  </div>
  <div class="filters none" id="filters">
    <div class="filters-title">
      <FilterSVG width={"23"} height={"27"} fill={"#2B4888"} />
      <h2>Filtrer</h2>
    </div>
    <form class="filters-form" id="filters-form">
      <div class="filter-form-cont">
        <select
          name="category"
          id="category"
          x-data="{ results: [] }"
          @populate-categories.window="results = $event.detail"
        >
          <option value="" selected>-- Catégorie --</option>
          <template x-for="item in results">
            <option
              :value="item"
              x-text="item.charAt(0).toUpperCase()+item.slice(1)"></option>
          </template>
        </select>
        <select
          name="location"
          id="location"
          x-data="{ results: [] }"
          @populate-locations.window="results = $event.detail"
        >
          <option value="" selected>-- Localité --</option>
          <template x-for="item in results">
            <option :value="item" x-text="item"></option>
          </template>
        </select>
      </div>
    </form>
    <div class="filters-swap swap">
      <ChatSVG width={"32"} height={"31"} fill={"#34939D"} />
      ou poser une question
    </div>
  </div>
</section>
<script>
  import Alpine from 'alpinejs';

  interface DisplayedItem {
    domain: string;
    name: string;
    desc?: string;
    displayName: string;
    displayDesc: string;
    streaming: boolean;
  }

  interface SearchResult {
    domain: string;
    name: string;
    desc?: string;
  }

  interface StreamingResults {
    count: number;
    displayed: DisplayedItem[];
    init(): void;
    startStreaming(results: SearchResult[]): Promise<void>;
    typeInto(obj: DisplayedItem, key: 'displayName' | 'displayDesc', fullText: string, msPerChar: number): Promise<void>;
    sleep(ms: number): Promise<void>;
  }

  document.addEventListener('alpine:init', () => {
    Alpine.data('streamingResults', (): StreamingResults => ({
      count: 20,
      displayed: [],

      init() {},

      async startStreaming(results) {
        this.displayed = [];

        for (const item of results) {
          const stub: DisplayedItem = {
            ...item,
            displayName: '',
            displayDesc: '',
            streaming: true,
          };
          this.displayed.push(stub);
          const ref = this.displayed[this.displayed.length - 1];

          await this.typeInto(ref, 'displayName', item.name, 25);

          if (item.desc) {
            await this.typeInto(ref, 'displayDesc', item.desc, 8);
          }

          ref.streaming = false;
          await this.sleep(120);
        }
      },

      typeInto(obj, key, fullText, msPerChar) {
        return new Promise((resolve) => {
          let i = 0;
          const tick = () => {
            const chunk = Math.max(1, Math.floor(Math.random() * 4) + 1);
            i = Math.min(i + chunk, fullText.length);
            obj[key] = fullText.slice(0, i);
            if (i < fullText.length) {
              setTimeout(tick, msPerChar + Math.random() * 20);
            } else {
              resolve();
            }
          };
          tick();
        });
      },

      sleep(ms) {
        return new Promise((r) => setTimeout(r, ms));
      },
    }));
  });
</script>

<script>
  const swap = document.querySelectorAll(".swap");
  swap.forEach((item) => {
    item.addEventListener("click", () => {
      const filter = document.getElementById("filters");
      const ai = document.getElementById("ai");
      filter?.classList.toggle("none");
      ai?.classList.toggle("none");
    });
  });
</script>
<script>
  import { $mapData } from "../lib/mapStore";
  import type { Data } from "../interfaces/dbData";

  const aiForm: HTMLFormElement = document.getElementById(
    "aiForm",
  ) as HTMLFormElement;
  const aiFormSubmit = document.getElementById("aiFormSubmit");
  const filterForm: HTMLFormElement = document.getElementById(
    "filters-form",
  ) as HTMLFormElement;
  const searchBar: HTMLInputElement = document.getElementById(
    "search-bar",
  ) as HTMLInputElement;
  const clearSearch = document.getElementById("clear-search");
  const infoTitle = document.getElementById("infoTitle");
  let currentSearch = "";

  async function populateFilters() {
    const cat = document.getElementById("category");
    const loc = document.getElementById("location");
    const res = await fetch("/api/dataInit", {
      method: "GET",
    });
    const baseData = await res.json();
    const data: Data[] = baseData.data;
    $mapData.set(data);
    const allCat: string[] = [
      ...new Set(
        data.flatMap((item) => item.category.map((cat) => cat.toLowerCase())),
      ),
    ].filter((el) => {return el!=""});
    const eventCat = new CustomEvent("populate-categories", { detail: allCat.sort() });
    window.dispatchEvent(eventCat);
    console.log(allCat.sort());
    const allLoc = [...new Set(data.map((item) => item.city))].filter((el) => {return el!=""});
    const eventLoc = new CustomEvent("populate-locations", { detail: allLoc.sort() });
    window.dispatchEvent(eventLoc);
  }
  populateFilters();

  aiFormSubmit?.addEventListener("click", async (e) => {
    e.preventDefault();
    const formData = new FormData(aiForm);
    const response = await fetch("/api/dataRetrieve", {
      method: "POST",
      body: formData,
    });
    if (response.status === 200) {
      const result = await response.json();
      const data: Data[] = result.data;
      currentSearch = searchBar.value;
      searchBar.value = "";
      const event = new CustomEvent("search-finished", { detail: data });
      window.dispatchEvent(event);
      infoTitle?.classList.add("none")
      $mapData.set(data);
      clearSearch?.classList.add("none");
    }
  });

  aiForm?.addEventListener("input", (e) => {
    if (searchBar.value !== "") {
      clearSearch?.classList.remove("none");
    } else {
      clearSearch?.classList.add("none");
    }
  });

  clearSearch?.addEventListener("click", () => {
    searchBar.value = "";
    clearSearch.classList.add("none");
  });

  filterForm?.addEventListener("change", async (e) => {
    e.preventDefault();
    const formData = new FormData(filterForm);
    const response = await fetch("/api/dataFilter", {
      method: "POST",
      body: formData,
    });
    if (response.status === 200) {
      const result = await response.json();
      const data: Data[] = result.data;
      $mapData.set(data);
    }
  });
</script>
<style>
  .map-search {
    width: 90%;
    background-color: rgb(var(--bg-color-1));
    margin-top: auto;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 4vh;
  }
  .ai {
  }
  .ai-response-cont {
    overflow-y: scroll;
    max-height: 67vh;
    padding: 0 10px;
  }
  .ai-response-element {
    padding: 0 10px;
  }
  :global(.ai-response-element h3) {
    margin-bottom: 1vh;
  }
  :global(.ai-response-element p) {
    margin-top: 0;
  }
  :global(.ai-response-btn) {
    background-color: #34939d;
    color: white;
    font-size: 1rem;
    margin-bottom: 1vh;
    border: none;
    cursor: pointer;
    padding: 5px 10px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  :global(.ai-response .ai-response-btn-cont) {
    display: flex;
    justify-content: right;
  }
  :global(.ai-response-separator) {
    border: 1.5px solid rgb(190, 190, 190);
    border-radius: 2px;
    margin-top: 0;
  }
  .ai-info-title {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .ai-search-cont {
    width: 100%;
    margin: 2vh auto auto auto;
    display: flex;
    flex-direction: row;
    border-radius: 10px;
    border-right: none;
    border-color: rgb(190, 190, 190);
    border-style: solid;
    border-width: 1px;
  }
  .ai-search-cont svg {
    cursor: pointer;
    width: 2.5rem;
    height: 100%;
    margin: auto;
    background-color: white;
  }
  .ai-search-cont:focus-within {
    outline: 1px solid #34939d;
    border-color: #34939d;
  }
  .ai-search-cont:focus-within .ai-search-btn {
    border-radius: 0 7px 7px 0;
  }
  .ai-search-bar {
    width: 100%;
    border: none;
    border-radius: 10px 0 0 10px;
    font-size: 1.05rem;
    padding: 10px;
    padding-right: 0;
  }
  .ai-search-bar:focus {
    outline: none;
  }
  .ai-search-btn {
    width: 20%;
    min-width: 90px;
    border: none;
    border-radius: 0 9px 9px 0;
    cursor: pointer;
    border: none;
    background-color: #34939d;
    color: white;
    font-size: 1.05rem;
  }
  .ai-swap svg {
    color: #2b4888;
  }
  .filters-title {
    width: fit-content;
    padding: 2vh;
    display: flex;
    flex-direction: row;
    justify-content: left;
    align-items: center;
    gap: 0.5vw;
    background-color: rgba(43, 72, 136, 0.2);
    border-radius: 10px;
    color: #2b4888;
    margin-bottom: 3vh;
  }
  .filters-title h2 {
    margin: auto;
  }
  .filter-form-cont {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2vh;
  }
  .filter-form-cont select {
    width: 100%;
    text-align: center;
    font-size: 1.2rem;
    border-radius: 10px;
    padding: 1vh;
    border-color: rgb(228, 227, 227);
    border-style: solid;
    border-width: 1px;
  }
  .none {
    display: none;
  }
  .ai-swap,
  .filters-swap {
    cursor: pointer;
    width: fit-content;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 1vw;
    margin-top: 1vh;
    text-decoration: underline;
    height: 4vh;
  }
  .ai-swap svg,
  .filters-swap svg {
    width: 1.4rem;
  }
  .pointer {
    cursor: pointer;
  }
  .underline{
    text-decoration: underline;
  }
</style>
