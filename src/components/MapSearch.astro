---
import FilterSVG from "../assets/filter.svg";
import ChatSVG from "../assets/chat.svg";
import LinkSVG from "../assets/link.svg";
import XSVG from "../assets/cross.svg";
---

<section class="map-search">
  <div class="ai" id="ai">
    <div class="ai-info">
      <h2 class="ai-info-title">
        Avec Éclaire, nous apportons des <span class="ai-info-title-highlight"
          >réponses concrètes</span
        > aux problèmes numériques, là où vous en avez besoin.
      </h2>
    </div>
    <div
      class="ai-response none"
      id="ai-response"
      x-data="{ results: [] }"
      @search-finished.window="results = $event.detail"
    >
      <template x-for="(item, i) in results" :key="item.domain">
        <div class="ai-reponse-element">
          <h3 x-text="item.name"></h3>
          <p
            x-text="item.desc.length > 100 ? item.desc.substr(0, item.desc.lastIndexOf(' ', 100)) + ' ' : item.desc"
          >
          </p>
          <div class="ai-response-btn-cont">
            <a :href="item.domain" target="_blank" class="ai-response-btn"
              >Visiter le site <LinkSVG /></a
            >
          </div>
          <template x-if="i < results.length -1">
            <hr class="ai-response-separator" />
          </template>
        </div>
      </template>
    </div>
    <form
      class="ai-search"
      id="aiForm"
      onkeydown="if(event.keyCode === 13){document.getElementById('aiFormSubmit').click(); return false}"
    >
      <div class="ai-search-cont">
        <input
          type="text"
          class="ai-search-bar"
          id="search-bar"
          name="search"
          value=""
          autofocus
          placeholder="Poser une question"
        />
        <XSVG id={"clear-search"} class={"none"} />
        <button type="button" class="ai-search-btn" id="aiFormSubmit"
          >Envoyer</button
        >
      </div>
    </form>
    <div class="ai-swap swap">
      <FilterSVG width={"23"} height={"27"} fill={"#34939D"} />
      <span class="ai-swap-link"> ou afficher les filtres </span>
    </div>
  </div>
  <div class="filters none" id="filters">
    <div class="filters-title">
      <FilterSVG width={"23"} height={"27"} fill={"#2B4888"} />
      <h2>Filtrer</h2>
    </div>
    <form class="filters-form" id="filters-form">
      <div class="filter-form-cont">
        <select name="category" id="category">
          <option value="" selected>-- Catégorie --</option>
        </select>
        <select name="location" id="location">
          <option value="" selected>-- Code Postal --</option>
        </select>
      </div>
    </form>
    <div class="filters-swap swap">
      <ChatSVG width={"32"} height={"31"} fill={"#34939D"} />
      ou poser une question
    </div>
  </div>
</section>
<section class="map-search-phone"></section>
<script>
  const swap = document.querySelectorAll(".swap");
  swap.forEach((item) => {
    item.addEventListener("click", () => {
      const filter = document.getElementById("filters");
      const ai = document.getElementById("ai");
      filter?.classList.toggle("none");
      ai?.classList.toggle("none");
    });
  });
</script>
<script>
  import { $mapData } from "../lib/mapStore";
  import type { Data } from "../interfaces/dbData";

  const aiForm: HTMLFormElement = document.getElementById(
    "aiForm",
  ) as HTMLFormElement;
  const aiFormSubmit = document.getElementById("aiFormSubmit");
  const filterForm: HTMLFormElement = document.getElementById(
    "filters-form",
  ) as HTMLFormElement;
  const searchBar: HTMLInputElement = document.getElementById(
    "search-bar",
  ) as HTMLInputElement;
  const clearSearch = document.getElementById("clear-search");
  const aiAnswer = document.getElementById("ai-response");
  let currentSearch = "";

  async function populateFilters() {
    const cat = document.getElementById("category");
    const loc = document.getElementById("location");
    const res = await fetch("/api/baseData", {
      method: "GET",
    });
    const baseData = await res.json();
    const data: Data[] = baseData.data;
    $mapData.set(data);
    let allCat: string[] = [];
    let allLoc: string[] = [];
    for (const item of data) {
      allCat = allCat.concat(item.category);
    }
    allCat = [...new Set(allCat.map((c) => c.toLowerCase()))];
    for (let i = 0; i < allCat.length; i++) {
      let opt = document.createElement("option");
      opt.value = allCat[i];
      opt.innerHTML = allCat[i].charAt(0).toUpperCase() + allCat[i].slice(1);
      cat?.appendChild(opt);
    }
    for (const item of data) {
      const code = item.address.match(/\b[1-9]\d{3}\b/)?.[0] ?? "";
      if (code) allLoc.push(code);
    }
    allLoc = [...new Set(allLoc)];
    for (let i = 0; i < allLoc.length; i++) {
      let opt = document.createElement("option");
      opt.value = allLoc[i].toString();
      opt.innerHTML = allLoc[i].toString();
      loc?.appendChild(opt);
    }
  }
  populateFilters();

  aiFormSubmit?.addEventListener("click", async (e) => {
    e.preventDefault();
    const formData = new FormData(aiForm);
    const response = await fetch("/api/dataGet", {
      method: "POST",
      body: formData,
    });
    if (response.status === 200) {
      const result = await response.json();
      const data: Data[] = result.data;
      const event = new CustomEvent("search-finished", { detail: data });
      window.dispatchEvent(event);
      aiAnswer?.classList.remove("none");
      $mapData.set(data);
      currentSearch = searchBar.value;
      searchBar.value = "";
      clearSearch?.classList.add("none");
    }
  });

  aiForm?.addEventListener("input", (e) => {
    if (searchBar.value !== "") {
      clearSearch?.classList.remove("none");
    } else {
      clearSearch?.classList.add("none");
    }
  });

  clearSearch?.addEventListener("click", () => {
    searchBar.value = "";
    clearSearch.classList.add("none");
  });

  filterForm?.addEventListener("change", async (e) => {
    e.preventDefault();
    const formData = new FormData(filterForm);
    const response = await fetch("/api/filterSearch", {
      method: "POST",
      body: formData,
    });
    if (response.status === 200) {
      const result = await response.json();
      const data: Data[] = result.data;
      $mapData.set(data);
    }
  });
</script>
<style>
  .map-search {
    width: 35vw;
    min-width: 400px;
    max-height: 80vh;
    background-color: rgb(var(--bg-color-1));
    position: absolute;
    right: 2vw;
    bottom: 5vh;
    z-index: 1000;
    border-radius: 15px;
    padding: 15px;
  }
  .ai {
  }
  .ai-response {
    overflow-y: scroll;
    max-height: 50vh;
    padding: 0 10px;
  }
  :global(.ai-response-element) {
    padding: 0 10px;
  }
  :global(.ai-response-element h3) {
    margin-bottom: 1vh;
  }
  :global(.ai-response-element p) {
    margin-top: 0;
  }
  :global(.ai-response-btn) {
    background-color: #34939d;
    color: white;
    font-size: 1rem;
    margin-bottom: 1vh;
    border: none;
    cursor: pointer;
    padding: 5px 10px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  :global(.ai-response .ai-response-btn-cont) {
    display: flex;
    justify-content: right;
  }
  :global(.ai-response-separator) {
    border: 1.5px solid rgb(190, 190, 190);
    border-radius: 2px;
    margin-top: 0;
  }
  .ai-info-title {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .ai-search-cont {
    width: 100%;
    margin: 2vh auto auto auto;
    display: flex;
    flex-direction: row;
    border-radius: 10px;
    border-right: none;
    border-color: rgb(190, 190, 190);
    border-style: solid;
    border-width: 1px;
  }
  .ai-search-cont svg {
    cursor: pointer;
    width: 2.5rem;
    height: 100%;
    margin: auto;
    background-color: white;
  }
  .ai-search-cont:focus-within {
    outline: 1px solid #34939d;
    border-color: #34939d;
  }
  .ai-search-cont:focus-within .ai-search-btn {
    border-radius: 0 7px 7px 0;
  }
  .ai-search-bar {
    width: 100%;
    border: none;
    border-radius: 10px 0 0 10px;
    font-size: 1.05rem;
    padding: 10px;
    padding-right: 0;
  }
  .ai-search-bar:focus {
    outline: none;
  }
  .ai-search-btn {
    width: 20%;
    min-width: 90px;
    border: none;
    border-radius: 0 9px 9px 0;
    cursor: pointer;
    border: none;
    background-color: #34939d;
    color: white;
    font-size: 1.05rem;
  }
  .ai-swap svg {
    color: #2b4888;
  }
  .filters-title {
    width: fit-content;
    padding: 2vh;
    display: flex;
    flex-direction: row;
    justify-content: left;
    align-items: center;
    gap: 0.5vw;
    background-color: rgba(43, 72, 136, 0.2);
    border-radius: 10px;
    color: #2b4888;
    margin-bottom: 3vh;
  }
  .filters-title h2 {
    margin: auto;
  }
  .filter-form-cont {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2vh;
  }
  .filter-form-cont select {
    width: 100%;
    text-align: center;
    font-size: 1.2rem;
    border-radius: 10px;
    padding: 1vh;
    border-color: rgb(228, 227, 227);
    border-style: solid;
    border-width: 1px;
  }
  .none {
    display: none;
  }
  .ai-swap,
  .filters-swap {
    cursor: pointer;
    width: fit-content;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 1vw;
    margin-top: 1vh;
    text-decoration: underline;
    height: 4vh;
  }
  .ai-swap svg,
  .filters-swap svg {
    width: 1.4rem;
  }
</style>
