<section class="map-search">
  <div class="ai" id="ai">
    <div class="ai-info">
      <h2 class="ai-info-title">
        Avec Éclaire, nous apportons des <span class="ai-info-title-highlight"
          >réponses concrètes</span
        > aux problèmes numériques, là où vous en avez besoin.
      </h2>
    </div>
    <div class="ai-response"></div>
    <form
      class="ai-search"
      id="aiForm"
      onkeydown="if(event.keyCode === 13){document.getElementById('aiFormSubmit').click(); return false}"
    >
      <input type="text" class="ai-search-bar" name="search" />
      <button type="button" id="aiFormSubmit">Envoyer</button>
    </form>
    <div class="ai-swap swap">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-filter"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227"
        ></path></svg
      >
      <span class="ai-swap-link"> ou afficher les filtres </span>
    </div>
  </div>
  <div class="filters none" id="filters">
    <div class="filters-title">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-filter-pin"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M12 20l-3 1v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414"
        ></path><path
          d="M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879"
        ></path><path d="M19 18v.01"></path></svg
      >
      Filtrer
    </div>
    <div class="filters-choices">
      <select name="" id="">
        <option value=""></option>
        <option value=""></option>
      </select>
      <select name="" id="">
        <option value=""></option>
        <option value=""></option>
      </select>
      <select name="" id="">
        <option value=""></option>
        <option value=""></option>
      </select>
      <select name="" id="">
        <option value=""></option>
        <option value=""></option>
      </select>
    </div>
    <div class="filters-swap swap">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-subtitles-ai"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M11.5 19h-5.5a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v4"
        ></path><path d="M7 15h5"></path><path d="M17 12h-3"></path><path
          d="M11 12h-1"></path><path
          d="M19 22.5a4.75 4.75 0 0 1 3.5 -3.5a4.75 4.75 0 0 1 -3.5 -3.5a4.75 4.75 0 0 1 -3.5 3.5a4.75 4.75 0 0 1 3.5 3.5"
        ></path></svg
      >
      ou poser une question
    </div>
  </div>
</section>
<section class="map-search-phone"></section>
<script>
  const swap = document.querySelectorAll(".swap");
  swap.forEach((item) => {
    item.addEventListener("click", () => {
      const filter = document.getElementById("filters");
      const ai = document.getElementById("ai");
      if (filter?.classList.contains("none")) {
        filter.classList.remove("none");
        ai?.classList.add("none");
      } else {
        ai?.classList.remove("none");
        filter?.classList.add("none");
      }
    });
  });
</script>
<script>
  import { $mapData } from "../lib/mapStore";
  const aiForm = document.getElementById("aiForm");
  const aiFormSubmit = document.getElementById("aiFormSubmit");

  aiFormSubmit?.addEventListener("click", async (e) => {
    e.preventDefault();
    const formData = new FormData(aiForm);
    const response = await fetch("/api/dataGet", {
      method: "POST",
      body: formData,
    });

    const result = await response.json();
    $mapData.set(result.data);
  });
</script>
<style>
  .map-search {
    width: 35vw;
    max-height: 80vh;
    background-color: rgb(var(--bg-color-1));
    position: absolute;
    right: 2vw;
    bottom: 5vh;
    z-index: 1000;
    border-radius: 15px;
    padding: 15px;
  }
  .ai {
  }
  .ai-info-title {
    margin-top: 0;
    font-size: 1.2rem;
    text-align: justify;
  }
  .none {
    display: none;
  }
  .ai-swap,
  .filters-swap {
    cursor: pointer;
  }
</style>
