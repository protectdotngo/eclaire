---
import AiInfoCard from "./sections/mapSearch/AiInfoSearch.astro";
import ConversationTimeline from "./sections/mapSearch/ConversationTimeline.astro";
import QuickQuestions from "./sections/mapSearch/QuickQuestions.astro";
import SearchBar from "./sections/mapSearch/SearchBar.astro";
import FiltersPanel from "./sections/mapSearch/FiltersPanel.astro";
---

<section class="map-search">
  <div class="ai" id="ai">
    <div class="ai-response-cont" id="ai-response-cont">
      <AiInfoCard />
      <ConversationTimeline />
    </div>
  </div>

  <div class="search-section">
    <QuickQuestions />
    <SearchBar />
  </div>

  <FiltersPanel />
</section>

<script>
  import Alpine from "alpinejs";
  import { createConversationTimeline } from "../lib/mapSearchState";
  import { initMapSearchController } from "../lib/mapSearchController";

  document.addEventListener("alpine:init", () => {
    Alpine.data("conversationTimeline", createConversationTimeline);
  });

  initMapSearchController();
</script>

<style>
  .map-search,
  .map-search * {
    box-sizing: border-box;
  }

  .map-search {
    width: 100%;
    margin: auto auto 0 auto;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .ai {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .ai-response-cont {
    overflow-y: auto;
    flex: 1;
    min-height: 0;
    padding: 0.5rem 1.5rem;
  }

  @media (max-width: 768px) {
    :global(body.mobile-menu-open) .ai-response-cont {
      max-height: calc(70vh - var(--mobile-menu-height, 0px));
    }
  }

  .search-section {
    background-color: rgba(255, 255, 255, 0.4);
  }
</style>
