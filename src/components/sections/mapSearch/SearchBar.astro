---
import FilterSVG from "../../../assets/filter.svg";
import XSVG from "../../../assets/cross.svg";
import RefreshSVG from "../../../assets/refresh.svg";
import EnterSVG from "../../../assets/corner-down-left.svg";
---

<div class="search" id="search">
  <div class="search-bar-filters">
    <form
      class="ai-search"
      id="aiForm"
      onkeydown="if(event.keyCode === 13 && !document.getElementById('aiFormSubmit').disabled){document.getElementById('aiFormSubmit').click(); return false}"
    >
      <div class="ai-search-cont">
        <input
          type="text"
          class="ai-search-bar"
          id="search-bar"
          name="search"
          value=""
          placeholder="Posez nous une question !"
        />
        <XSVG id={"clear-search"} class={"none"} />
        <button type="button" class="ai-search-btn" id="aiFormSubmit">
          <span>Envoyer</span><EnterSVG width={"18"} height={"18"} />
        </button>
      </div>
    </form>

    <div class="ai-actions">
      <button type="button" class="none ai-reset-btn" id="aiReset">
        <RefreshSVG width={"16"} height={"16"} /> Nouvelle recherche
      </button>
      <button class="ai-swap swap">
        <FilterSVG width={"18"} height={"22"} />
        <span class="ai-swap-link">Recherche par critères</span>
      </button>
    </div>
  </div>
</div>

<style>
  .search {
    width: 100%;
    padding: 0 1.5rem 0.5em;
    flex-shrink: 0;
  }

  .search-bar-filters {
    width: 100%;
    border: 1px solid rgba(var(--color-main-2), 1);
    margin: auto;
    border-radius: 12px;
    overflow: hidden;
    background-color: white;
  }

  .ai-search-cont {
    width: 100%;
    display: flex;
    align-items: center;
    flex-direction: row;
    background-color: white;
    min-width: 0;
  }

  .ai-search-bar {
    flex: 1 1 0;
    min-width: 0;
    border: none;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    background-color: transparent;
    color: #1f2937;
  }

  .ai-search-bar::placeholder {
    color: #1f2937;
    opacity: 0.85;
  }

  :global(#clear-search) {
    cursor: pointer;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0 0.5rem;
  }

  .ai-search-bar:focus {
    outline: none;
  }

  .ai-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border: none;
    cursor: pointer;
    background-color: rgba(var(--color-main-2), 0.5);
    color: white;
    font-size: 0.8rem;
    text-transform: uppercase;
    padding: 0.25rem 0.4rem;
    margin: 0.4rem;
    border-radius: 10px;
    white-space: nowrap;
    font-weight: 500;
    transition: ease-in-out 0.1s;
  }

  .ai-search-btn:not(:disabled):hover {
    background-color: rgba(var(--color-main-2), 0.7);
  }

  .ai-search-btn:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .ai-search-btn :global(svg) {
    position: relative;
    background-color: transparent;
    top: -1px;
  }

  .ai-actions {
    display: flex;
    gap: 0.5rem;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    background-color: rgba(var(--color-main-2), 1);
    padding: 0.5rem 1rem;
  }

  .ai-reset-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: transparent;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .ai-reset-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .ai-swap {
    cursor: pointer;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.1rem;
    color: white;
    font-size: 0.9rem;
    width: fit-content;
    border: none;
    background: transparent;
    transition: 0.15s ease;
    padding: 0;
  }

  .ai-swap:hover {
    opacity: 0.85;
  }

  .ai-swap :global(svg) {
    color: white;
    fill: white;
    width: 1.5rem;
  }

  .ai-swap-link {
    text-decoration: none;
  }
</style>
