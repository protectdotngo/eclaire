---
import ArrowSVG from "../../../assets/images/circle-arrow-right.svg";
import PinSVG from "../../../assets/images/map-pin.svg";
import PhoneSVG from "../../../assets/images/phone.svg";
import MailSVG from "../../../assets/images/mail.svg";
---

<div
  class="filtered-orgs"
  id="filteredOrgs"
  x-data="filteredOrgList()"
  x-init="init()"
>
  <p class="filtered-orgs-count" x-show="orgs.length > 0">
    <span x-text="orgs.length"></span>
    <span x-text="orgs.length > 1 ? ' organisations' : ' organisation'"></span>
  </p>

  <div class="filtered-orgs-list">
    <template x-for="(org, i) in orgs" :key="org.id ?? org.name + i">
      <div
        class="org-card"
        :class="{ 'result-card-2' : i % 2 !== 0, 'result-card': i % 2 === 0 }"
      >
        <h3 class="result-card-title" x-text="org.name"></h3>

        <template x-if="org.address || org.city">
          <p class="org-address">
            <span class="org-address-icon"><PinSVG /></span>
            <span x-text="[org.address, org.city].filter(Boolean).join(', ')"
            ></span>
          </p>
        </template>

        <template x-if="org.desc">
          <p
            class="result-card-desc"
            x-data="{
              expanded: false,
              get needsTruncation() { return (org.desc || '').length > 120; }
            }"
          >
            <span x-text="expanded ? org.desc : $truncate(org.desc, 120)"
            ></span>
            <template x-if="needsTruncation">
              <span class="read-more-wrap">
                <br />
                <span
                  class="read-more-link"
                  x-show="!expanded"
                  @click="expanded = true">Lire plus</span
                >
                <span
                  class="read-more-link"
                  x-show="expanded"
                  @click="expanded = false">Réduire</span
                >
              </span>
            </template>
          </p>
        </template>

        <template x-if="org.contact && org.contact.length > 0">
          <div class="org-contact-row">
            <template x-for="(c, ci) in org.contact" :key="ci">
              <a :href="formatContactHref(c)" class="org-contact-link">
                <template x-if="isEmail(c)">
                  <span class="org-contact-icon"><MailSVG /></span>
                </template>
                <template x-if="isPhone(c)">
                  <span class="org-contact-icon"><PhoneSVG /></span>
                </template>
                <span x-text="c"></span>
              </a>
            </template>
          </div>
        </template>

        <hr class="result-card-separator" />

        <div class="result-card-buttons">
          <template x-if="org.domain">
            <a :href="org.domain" target="_blank" class="btn btn-site">
              <span>Visiter le site</span>
              <span class="btn-arrow-circle"><ArrowSVG /></span>
            </a>
          </template>
          <template x-if="org.lat && org.lon">
            <button
              type="button"
              class="btn btn-zoom"
              @click="$dispatch('map-focus-org', { id: org.id, lat: org.lat, lon: org.lon })"
            >
              <span>Voir sur la carte</span>
              <PinSVG />
            </button>
          </template>
        </div>
      </div>
    </template>
  </div>

  <p class="filtered-orgs-empty" x-show="orgs.length === 0">
    Aucune organisation ne correspond à ces filtres.
  </p>
</div>

<script>
  import { $mapData } from "../../../lib/mapStore";
  import Alpine from "alpinejs";
  import type { OrgWithChatContext } from "../../../interfaces/org";

  document.addEventListener("alpine:init", () => {
    Alpine.data("filteredOrgList", () => ({
      orgs: [] as OrgWithChatContext[],
      _unsub: null as null | (() => void),

      init() {
        const initial = $mapData.get();
        this.orgs = initial ? [...initial] : [];
        this._unsub = $mapData.subscribe((value) => {
          this.orgs = value ? [...value] : [];
        });
      },

      isEmail(contact: string): boolean {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contact.trim());
      },
      isPhone(contact: string): boolean {
        const d = contact.trim().replace(/[\s().-]/g, "");
        return /^\+?\d{7,15}$/.test(d);
      },
      formatContactHref(contact: string): string {
        const t = contact.trim();
        if (this.isEmail(t)) return `mailto:${t}`;
        if (this.isPhone(t)) return `tel:${t.replace(/[\s().-]/g, "")}`;
        return t;
      },
    }));
  });
</script>

<style>
  .filtered-orgs {
    padding: 0 0 1rem;
    overflow-y: auto;
  }

  .filtered-orgs-count {
    font-size: 1rem;
    font-weight: 600;
    color: rgba(var(--color-main-2), 1);
    letter-spacing: 0.03em;
    margin: 1rem 1rem 0.75rem;
  }

  .filtered-orgs-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .org-card {
    border: 1px solid #e6e6e6;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    background: white;
  }

  .result-card-2 {
    background: rgba(var(--color-main-2), 0.05);
  }

  .result-card-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: #1f2937;
    margin: 0 0 0.4rem;
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk),
      var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
  }

  .org-address {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: #6b7280;
    margin: 0 0 0.5rem;
  }

  .org-address-icon :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    stroke: rgba(var(--color-main-2), 1);
  }

  .result-card-desc {
    font-size: 1rem;
    line-height: 1.5;
    color: #4b5563;
    margin: 0 0 0.6rem;
  }

  .read-more-link {
    color: rgba(var(--color-main-2), 1);
    cursor: pointer;
    text-decoration: underline;
    font-size: 0.85rem;
  }
  .read-more-link:hover {
    color: rgba(var(--color-main-2-dark), 1);
  }

  .org-contact-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .org-contact-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(var(--color-main-2), 1);
    text-decoration: underline;
    width: fit-content;
  }
  .org-contact-link:hover {
    color: rgba(var(--color-main-2-dark), 1);
  }
  .org-contact-link:visited {
    color: rgba(var(--color-main-2), 1);
  }

  .org-contact-icon :global(svg) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .result-card-separator {
    border: none;
    border-top: 1px solid rgba(var(--color-main-2), 0.15);
    margin: 0.85rem 0;
  }

  .result-card-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.filtered-orgs .btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    border: none;
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk),
      var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
    transition:
      filter 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  :global(.filtered-orgs .btn-site) {
    background: rgba(var(--color-main-2), 1);
    color: white;
  }
  :global(.filtered-orgs .btn-site:hover) {
    background: rgba(var(--color-main-2-dark), 1);
  }

  :global(.filtered-orgs .btn-zoom) {
    background: white;
    color: rgba(var(--color-main-2), 1);
    border: 1.5px solid rgba(var(--color-main-2), 0.3);
  }
  :global(.filtered-orgs .btn-zoom:hover) {
    background: rgba(var(--color-main-2), 0.05);
    border-color: rgba(var(--color-main-2), 1);
  }

  :global(.filtered-orgs .btn-zoom svg),
  :global(.filtered-orgs .btn-arrow-circle svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .filtered-orgs-empty {
    text-align: center;
    padding: 2rem 1rem;
    color: #6b7280;
    font-size: 0.9rem;
  }
</style>
