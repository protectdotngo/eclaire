<section class="tech-section">
  <h2 class="tech-section-title">Pile technique</h2>

  <div class="stack-grid">
    <div class="stack-category">
      <h3 class="stack-category-title">Frontend</h3>
      <ul class="stack-list">
        <li>
          <strong>Astro</strong> — framework de rendu hybride statique/serveur
        </li>
        <li>
          <strong>Alpine.js</strong> — réactivité côté client, sans bundle lourd
        </li>
        <li>
          <strong>Leaflet</strong> — carte interactive, librairie open source
        </li>
        <li><strong>Flatpickr</strong> — sélecteur de date</li>
      </ul>
    </div>

    <div class="stack-category">
      <h3 class="stack-category-title">Backend & données</h3>
      <ul class="stack-list">
        <li><strong>PostgreSQL</strong> — base de données relationnelle</li>
        <li>
          <strong>Drizzle ORM</strong> — accès à la base, type-safe TypeScript
        </li>
        <li>
          <strong>API REST minimaliste</strong> — endpoints servis par Astro
        </li>
      </ul>
    </div>

    <div class="stack-category">
      <h3 class="stack-category-title">Automatisation & IA</h3>
      <ul class="stack-list">
        <li><strong>n8n</strong> — orchestration des workflows de scraping</li>
        <li>
          <strong>Qwen 235B</strong> — modèle de langage open source (via Scaleway)
        </li>
      </ul>
    </div>

    <div class="stack-category">
      <h3 class="stack-category-title">Déploiement</h3>
      <ul class="stack-list">
        <li>
          <strong>Vercel</strong> — hébergement du site et fonctions serveur
        </li>
        <li><strong>pnpm</strong> — gestion des dépendances</li>
      </ul>
    </div>
  </div>
</section>

<style>
