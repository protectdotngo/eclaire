---
import ArrowMove from "../../../assets/images/arrow-move-right.svg";
import Background from "../general/Background.astro";
---

<section class="tech-section">
  <Background />
  <div class="tech-section-box">
    <h2 class="tech-section-title">Vue d'ensemble de l'architecture</h2>
    <p class="tech-section-intro">
      éclaire repose sur trois composants principaux, conçus pour fonctionner
      indépendamment tout en se nourrissant mutuellement :
    </p>
  </div>

  <div class="arch-diagram-html">
    <div class="arch-label">
      <span>Flux de données</span>
    </div>

    <div class="arch-row">
      <div class="arch-box">
        <h3>Collecte</h3>
        <ul>
          <li>Scraping automatisé</li>
          <li>Extraction IA</li>
        </ul>
        <span class="arch-box-label">n8n</span>
      </div>

      <div class="arch-arrow" aria-hidden="true">
        <ArrowMove />
      </div>

      <div class="arch-box">
        <h3>Base de données</h3>
        <ul>
          <li>Organisations</li>
          <li>Événements, news</li>
        </ul>
        <span class="arch-box-label">PostgreSQL</span>
      </div>

      <div class="arch-arrow" aria-hidden="true">
        <ArrowMove />
      </div>

      <div class="arch-box">
        <h3>Interface</h3>
        <ul>
          <li>Carte interactive</li>
          <li>Recherche IA</li>
        </ul>
        <span class="arch-box-label">Astro + Alpine</span>
      </div>
    </div>

    <div class="arch-down-arrow" aria-hidden="true">
      <ArrowMove />
    </div>

    <div class="arch-box arch-box-llm">
      <h3>Assistant conversationnel</h3>
      <ul>
        <li>Qwen 235B</li>
      </ul>
      <span class="arch-box-llm-label">Planificateur de requêtes</span>
    </div>
  </div>
</section>

<style>
  .tech-section {
    margin: 8rem auto 3.5rem auto;
    position: relative;
  }

  .tech-section-box {
    padding: 0 1.5rem;
  }

  .tech-section-title {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 1.25rem;
    color: transparent;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 81.13%);
    background-clip: text;
  }

  .tech-section-intro {
    font-size: 1rem;
    color: #374151;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 500px;
  }

  .arch-diagram-html {
    padding: 2rem 1.5rem;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .arch-label {
    width: 100%;
    font-size: 1.6rem;
    font-weight: 600;
    color: black;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: baseline;
  }

  .arch-row {
    display: flex;
    align-items: center;
    gap: 0;
    width: 100%;
    max-width: 800px;
  }

  .arch-box {
    flex: 1;
    background: white;
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: baseline;
    justify-content: center;
    text-align: left;
    min-height: 130px;
    box-shadow: 0 8px 28px rgba(var(--color-main-3), 0.25);
  }

  .arch-box h3 {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
    font-weight: 600;
    color: #1f2937;
  }

  .arch-box ul {
    margin: 2rem 0;
    font-size: 1rem;
    color: black;
    line-height: 1.5;
  }

  .arch-box-label {
    margin-top: 0.75rem;
    align-self: flex-end;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    color: white;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 81.13%);
  }

  .arch-arrow {
    flex-shrink: 0;
    width: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
    color: rgba(var(--color-main-2), 1);
  }

  .arch-arrow svg {
    width: 36px;
    height: 36px;
  }

  .arch-down-arrow {
    margin: 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-main-2), 1);
  }

  .arch-down-arrow svg {
    width: 36px;
    height: 36px;
    transform: rotate(90deg);
  }

  .arch-box-llm {
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 81.13%);
    border-color: transparent;
    max-width: 320px;
    padding: 1rem;
    min-height: auto;
  }

  .arch-box-llm ul {
    margin: 2rem 0;
    font-size: 1rem;
    color: white;
    line-height: 1.5;
  }

  .arch-box-llm h3 {
    color: white;
  }

  .arch-box-llm-label {
    margin-top: 0.75rem;
    align-self: flex-end;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    color: white;
    background: transparent;
    border: 1px solid white;
  }

  @media (max-width: 1375px) {
    .tech-section {
      margin: 5rem auto 3.5rem auto;
    }
  }

  @media (max-width: 900px) {
    .tech-section {
      margin: 1.5rem auto 3.5rem auto;
    }
  }

  @media (max-width: 768px) {
    .tech-section-title {
      font-size: 1.3rem;
    }

    .arch-row {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0;
    }

    .arch-box {
      width: 100%;
      min-height: auto;
      padding: 1.25rem 1rem;
    }

    .arch-arrow {
      width: 100%;
      height: 50px;
      padding: 0.5rem 0;
    }

    .arch-arrow svg {
      transform: rotate(90deg);
    }

    .arch-box-llm {
      width: 100%;
      max-width: 320px;
      padding: 1.25rem 1rem;
    }
  }
</style>
