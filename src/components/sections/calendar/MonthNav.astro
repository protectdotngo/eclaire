---
import ChevronRightSVG from "../../../assets/chevron-right.svg";
import ChevronLeftSVG from "../../../assets/chevron-left.svg";
import RefreshSVG from "../../../assets/refresh.svg";
---

<div class="month-nav">
  <button
    type="button"
    class="month-nav-btn"
    :class="(!includePast && isCurrentMonth) ? 'month-nav-btn-disabled' : ''"
    :disabled="!includePast && isCurrentMonth"
    @click="prevMonth()"
    aria-label="Mois précédent"
  >
    <ChevronLeftSVG />
  </button>
  <h2 class="month-nav-title" x-text="currentMonthLabel"></h2>
  <button
    type="button"
    class="month-nav-btn"
    @click="nextMonth()"
    aria-label="Mois suivant"
  >
    <ChevronRightSVG />
  </button>
  <button
    type="button"
    class="month-nav-today"
    @click="goToToday()"
    x-show="!isCurrentMonth"
    x-transition.opacity.duration.200ms
  >
    <RefreshSVG />
    <span>Aujourd'hui</span>
  </button>
</div>

<style>
  .month-nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    margin: 2rem 0 1.5rem;
    flex-wrap: wrap;
  }

  .month-nav-btn {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #d1d5db;
    border-radius: 50%;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-main-2), 1);
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .month-nav-btn:not(:disabled):hover {
    background: color-mix(in srgb, rgb(var(--color-main-2)) 8%, white);
    border-color: rgba(var(--color-main-2), 1);
  }

  .month-nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .month-nav-title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
    color: transparent;
    background: linear-gradient(54.55deg, #b52ec4 11.79%, #ed1e79 81.13%);
    background-clip: text;
    letter-spacing: 0.02em;
  }

  .month-nav-today {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    background: white;
    cursor: pointer;
    font-size: 0.85rem;
    color: rgba(var(--color-main-2), 1);
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
    margin-left: 0.5rem;
  }

  .month-nav-today:hover {
    background-color: rgba(var(--color-main-2), 0.05);
    border-color: rgba(var(--color-main-2), 1);
  }

  .month-nav-today svg {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .month-nav-title {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 440px) {
    .month-nav {
      justify-content: center;
    }
  }
</style>
