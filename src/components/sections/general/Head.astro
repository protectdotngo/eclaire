---
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string | undefined;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/images/og-image.jpg", Astro.site);
const pageDesc = description
  ? description
  : "Bienvenue sur éclaire, le phare numérique : le guide IA de l'inclusion et de la résilience numérique.";
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={pageDesc} />

  <Font cssVariable="--font-inter-tight" preload />
  <Font cssVariable="--font-neue-haas-grotesk" preload />
  {
    __HAS_FOUNDERS_GROTESK__ && (
      <Font cssVariable="--font-founders-grotesk" preload />
    )
  }

  <!-- Facebook Meta Tags -->
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={ogImageURL} />

  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="twitter:domain" content="protect.ngo" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImageURL} />

  <title>{title}</title>

  <!-- Google tag (gtag.js) -->
  <script
    async
    is:inline
    src="https://www.googletagmanager.com/gtag/js?id=G-FH1JTNMC8R"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "G-FH1JTNMC8R");
  </script>
</head>
