---
import { Font } from "astro:assets";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <Font cssVariable="--font-inter-tight" preload />
  <Font cssVariable="--font-neue-haas-grotesk" preload />
  <Font cssVariable="--font-founders-grotesk-medium" preload />
  <Font cssVariable="--font-founders-grotesk" preload />
  <title>{title}</title>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FH1JTNMC8R"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "G-FH1JTNMC8R");
  </script>
</head>
