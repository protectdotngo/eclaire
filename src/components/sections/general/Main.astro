---
import Nav from "../../Nav.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<main class="main">
  <div class="navContMain">
    <Nav class={className} />
  </div>
  <slot />
</main>

<style>
  .main {
    width: 100%;
    position: relative;
  }
</style>
