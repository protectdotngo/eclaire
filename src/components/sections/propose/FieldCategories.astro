---
import { DISPLAY_BUCKETS } from "../../../data/calendarConfig";
import { AUDIENCE_TAGS } from "../../../data/audienceTags";

const CATEGORIES = DISPLAY_BUCKETS.flatMap((bucket) =>
  bucket.categories.map((cat) => ({
    name: cat,
    label: cat.charAt(0).toUpperCase() + cat.slice(1),
    color: bucket.colors.light.main,
    bg: bucket.colors.light.container,
    text: bucket.colors.light.onContainer,
  })),
);

const AUDIENCES = AUDIENCE_TAGS.map((tag) => ({
  name: tag,
  label: tag.charAt(0).toUpperCase() + tag.slice(1),
}));
---

<div class="field">
  <label class="field-label">
    Catégories thématiques
    <span class="field-required">*</span>
  </label>
  <p class="field-hint">
    Sélectionne toutes les catégories qui décrivent ton organisation.
  </p>
  <div class="chip-row">
    {
      CATEGORIES.map((cat) => (
        <button
          type="button"
          class="chip chip-category"
          data-cat={cat.name}
          :class="formData.categories.includes($el.dataset.cat) ? 'chip-active' : ''"
          style={`--chip-color:${cat.color};--chip-bg:${cat.bg};--chip-text:${cat.text}`}
          @click="toggleCategory($el.dataset.cat)"
        >
          <span class="dot"></span>
          <span>{cat.label}</span>
        </button>
      ))
    }
  </div>

  <label class="field-label" style="margin-top: 1rem;">Publics visés</label>
  <p class="field-hint">
    Sélectionne les publics que ton organisation cible.
  </p>
  <div class="chip-row">
    {
      AUDIENCES.map((aud) => (
        <button
          type="button"
          class="chip chip-audience"
          data-aud={aud.name}
          :class="formData.audience.includes($el.dataset.aud) ? 'chip-active' : ''"
          @click="toggleAudience($el.dataset.aud)"
        >
          {aud.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
  }

  .field-required {
    color: #c73b5d;
    margin-left: 0.15rem;
  }

  .field-hint {
    font-size: 0.8rem;
    color: #6b7280;
    margin: 0 0 0.25rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    cursor: pointer;
    background: white;
    font-family: inherit;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
    border: 1.5px solid;
  }

  .chip .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chip-category {
    border-color: var(--chip-color);
    color: var(--chip-color);
  }

  .chip-category:hover {
    background: color-mix(in srgb, var(--chip-bg) 40%, transparent);
  }

  .chip-category .dot {
    background: var(--chip-color);
  }

  .chip-category.chip-active {
    background: var(--chip-bg);
    color: var(--chip-text);
  }

  .chip-audience {
    border-color: #cbd5e1;
    color: #475569;
  }

  .chip-audience:hover {
    background: #4755690d;
  }

  .chip-audience.chip-active {
    background: #1e293b;
    color: white;
    border-color: #1e293b;
  }
</style>