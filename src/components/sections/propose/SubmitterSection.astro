---
import FieldText from "./FieldText.astro";
import FieldSelect from "./FieldSelect.astro";
---

<div class="proposal-section">
  <h2 class="proposal-section-title">À propos de toi</h2>

  <FieldSelect
    name="submitter_type"
    label="Tu es"
    required
    model="formData.submitter_type"
  >
    <option value="">Sélectionne...</option>
    <option value="organisation">Une organisation</option>
    <option value="particulier">Un particulier</option>
  </FieldSelect>

  <FieldSelect
    name="action"
    label="Tu souhaites"
    required
    model="formData.action"
    changeHandler="onActionChange()"
  >
    <option value="">Sélectionne...</option>
    <option value="propose">Proposer une nouvelle organisation</option>
    <option value="modify">Modifier une organisation existante</option>
  </FieldSelect>

  <div x-show="formData.action === 'modify'" x-transition>
    <FieldSelect
      name="modifying_org"
      label="Organisation à modifier"
      visualRequired
      model="formData.modifying_org_id"
      changeHandler="onOrgSelected()"
    >
      <option value="">Sélectionne une organisation...</option>
      <template x-for="org in allOrgs" :key="org.id">
        <option :value="org.id" x-text="org.name"></option>
      </template>
    </FieldSelect>
  </div>

  <FieldText
    name="submitter_name"
    label="Ton nom"
    required
    placeholder="Prénom et nom"
  />

  <FieldText
    name="submitter_email"
    label="Ton email"
    type="email"
    required
    placeholder="Pour te recontacter si besoin"
  />
</div>

<style>
  .proposal-section {
    padding: 1.5rem 1.5rem 0 1.5rem;
  }

  .proposal-section-title {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
  }

  @media (max-width: 768px) {
    .proposal-section {
      padding: 1.25rem;
    }
  }
</style>
