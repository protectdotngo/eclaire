---
interface Props {
  name: string;
  label: string;
  placeholder?: string;
  type?: "text" | "url";
}

const { name, label, placeholder, type = "text" } = Astro.props;
---

<div class="field">
  <label class="field-label">{label}</label>
  <div class="array-items">
    <template x-for={`(item, idx) in formData.${name}`} :key="idx">
      <div class="array-item">
        <input
          type={type}
          class="field-input"
          placeholder={placeholder}
          :value="item"
          @input={`formData.${name}[idx] = $event.target.value`}
        />
        <button
          type="button"
          class="array-remove"
          @click={`formData.${name}.splice(idx, 1)`}
          aria-label="Retirer cette entrée"
        >
          ×
        </button>
      </div>
    </template>
    <button
      type="button"
      class="array-add"
      @click={`formData.${name}.push('')`}
    >
      + Ajouter
    </button>
  </div>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
  }

  .array-items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .array-item {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .field-input {
    flex: 1;
    padding: 0.6rem 0.9rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.95rem;
    background: white;
    color: #1f2937;
    font-family: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .field-input:focus {
    outline: none;
    border-color: #2b4888;
    box-shadow: 0 0 0 3px rgba(43, 72, 136, 0.12);
  }

  .array-remove {
    width: 2.5rem;
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1.2rem;
    color: #6b7280;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .array-remove:hover {
    background: rgba(199, 59, 93, 0.08);
    border-color: #dc436b;
    color: #dc436b;
  }

  .array-add {
    align-self: flex-start;
    padding: 0.4rem 0.85rem;
    background: transparent;
    border: 1.5px dashed #34719d;
    border-radius: 999px;
    color: #34719d;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: inherit;
    transition:
      background 0.15s ease,
      border-style 0.15s ease;
  }

  .array-add:hover {
    background: rgba(43, 72, 136, 0.05);
    border-style: solid;
  }
</style>
