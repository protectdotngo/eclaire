---
import ChevronSVG from "../../../assets/chevron-down.svg";

interface Props {
  name: string;
  label: string;
  required?: boolean;
  visualRequired?: boolean;
  model: string;
  changeHandler?: string;
}

const {
  name,
  label,
  required = false,
  visualRequired = false,
  model,
  changeHandler,
} = Astro.props;
---

<div class="field">
  <label class="field-label" for={name}>
    {label}
    {(required || visualRequired) && <span class="field-required">*</span>}
  </label>
  <div class="field-select-wrap">
    <select
      id={name}
      name={name}
      class="field-select"
      x-model={model}
      required={required}
      {...changeHandler ? { "@change": changeHandler } : {}}
    >
      <slot />
    </select>
    <span class="field-chevron">
      <ChevronSVG />
    </span>
  </div>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
  }

  .field-required {
    color: #c73b5d;
    margin-left: 0.15rem;
  }

  .field-select-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .field-select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    padding: 0.6rem 2.5rem 0.6rem 0.9rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.95rem;
    background: white;
    color: #1f2937;
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .field-select:focus {
    outline: none;
    border-color: #2b4888;
    box-shadow: 0 0 0 3px rgba(43, 72, 136, 0.12);
  }

  .field-chevron {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: #2b4888;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
