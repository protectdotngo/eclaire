---
interface Props {
  name: string;
  label: string;
  type?: "text" | "email" | "url";
  required?: boolean;
  placeholder?: string;
  value?: string;
}

const {
  name,
  label,
  type = "text",
  required = false,
  placeholder,
  value = "",
} = Astro.props;
---

<div class="field">
  <label class="field-label" for={name}>
    {label}
    {required && <span class="field-required">*</span>}
  </label>
  <input
    id={name}
    name={name}
    type={type}
    class="field-input"
    placeholder={placeholder}
    required={required}
    value={value}
    x-model={`formData.${name}`}
  />
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: black;
  }

  .field-required {
    color: rgba(var(--color-required), 1);
    margin-left: 0.15rem;
  }

  .field-input {
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(var(--color-main-2), 1);
    border-radius: 8px;
    font-size: 0.95rem;
    background: white;
    color: #1f2937;
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk), var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .field-input:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(var(--color-main-2), 0.15);
  }
</style>
