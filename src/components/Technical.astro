---
import TechHero from "./sections/sous-le-capot/TechHero.astro";
import OpenSourceBanner from "./sections/sous-le-capot/OpenSourceBanner.astro";
import ArchDiagram from "./sections/sous-le-capot/ArchDiagram.astro";
import FeatureGrid from "./sections/sous-le-capot/FeatureGrid.astro";
import QueryPlannerSection from "./sections/sous-le-capot/QueryPlaner.astro";
import TechStack from "./sections/sous-le-capot/TechStack.astro";
import VectorHistorySection from "./sections/sous-le-capot/VectorHistory.astro";
import ContributeSection from "./sections/sous-le-capot/Contribute.astro";
---

<section class="tech-page">
  <TechHero />
  <OpenSourceBanner />
  <ArchDiagram />
  <FeatureGrid />
  <QueryPlannerSection />
  <TechStack />
  <VectorHistorySection />
  <ContributeSection />
</section>

<style>
  .tech-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
    color: #1f2937;
    position: relative;
  }

  .tech-page::before {
    content: "";
    position: fixed;
    inset: 0 -5rem;
    z-index: -1;
    pointer-events: none;
    background-image:
      url("/decorations/protect3.svg"), url("/decorations/protect2.svg");
    background-repeat: repeat-y, repeat-y;
    background-position:
      right -2rem top 100px,
      left -4rem top 400px;
    background-size:
      auto 1000px,
      auto 1000px;
  }

  @media (max-width: 768px) {
    .tech-page {
      padding: 1.5rem 1rem 3rem;
    }
  }
</style>
