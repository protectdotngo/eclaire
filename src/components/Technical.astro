---
import Hero from "./sections/general/Hero.astro";
import ArchDiagram from "./sections/sous-le-capot/ArchDiagram.astro";
import FeatureGrid from "./sections/sous-le-capot/FeatureGrid.astro";
import QueryPlannerSection from "./sections/sous-le-capot/QueryPlaner.astro";
import TechStack from "./sections/sous-le-capot/TechStack.astro";
import VectorHistorySection from "./sections/sous-le-capot/VectorHistory.astro";
import ContributeSection from "./sections/sous-le-capot/Contribute.astro";
import Background from "./sections/general/Background.astro";
---

<section class="tech-page">
  <Hero
    title="Sous le capot"
    lead="Une plateforme ouverte pour cartographier l'inclusion numérique à Genève."
    lead2="100% open source, 100% open data"
    body="Le code source d'Éclaire et l'ensemble des données collectées sont librement consultables. Cette transparence est au cœur du projet: tout ce qui est cartographié est public, réutilisable, et vérifiable."
    image="/images/engine.jpg"
  />
  <ArchDiagram />
  <FeatureGrid />
  <QueryPlannerSection />
  <TechStack />
  <div class="tech-page-last">
    <Background />
    <VectorHistorySection />
    <ContributeSection />
  </div>
</section>

<style>
  .tech-page {
    width: 100%;
    margin: 0 auto;
    color: #1f2937;
    position: relative;
    z-index: 0;
    overflow: hidden;
    padding-bottom: 4rem;
  }

  .tech-page > :global(*:not(.image)) {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem;
    padding-right: 2rem;
    box-sizing: border-box;
  }

  .tech-page-last {
    display: flex;
    flex-direction: row;
    gap: 3rem;
    position: relative;
  }

  @media (max-width: 768px) {
    .tech-page > :global(*:not(.image)) {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .tech-page-last {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }
  }
</style>
