---
import eclaireLogo from "../assets/eclaire.svg";
import eclaireI from "../assets/eclaire_i.svg"
import Image from "astro/components/Image.astro";
---

<header class="navCont">
  <Image src={eclaireI} alt="Eclaire's logo small" class:list={"logo-min none"} />
  <div class="nav">
    <a href="/">
      <Image src={eclaireLogo} alt="Eclaire's logo" class:list={"logo"} />
    </a>
    <div>
      <a href="/">Accueil</a>
      <a href="#">Partenaires</a>
      <a href="#">Ressources utiles</a>
    </div>
  </div>
</header>

<style>
  .navCont {
    width: 100%;
    height: 10vh;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .logo {
    width: auto;
    height: 10vh;
  }
  .logo-min{
    width: auto;
    height: 7vh;
    display: none;
    margin: auto;
    padding: 1.5vh;
  }
  .nav div {
    margin-right: 1vw;
    display: flex;
    gap: 2vw;
  }
  .nav div a {
    color: var(--color-1);
    text-decoration: none;
    font-size: 1.2rem;
  }
  .nav div a:hover {
    color: rgba(var(--color-2), 1);
  }
</style>
