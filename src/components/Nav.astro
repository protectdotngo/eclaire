---
import EclaireLogo from "../assets/eclaire.svg";
import EclaireI from "../assets/eclaire_i.svg";
---

<header class="navCont">
  <EclaireI class="logo-min none" />
  <div class="nav">
    <a href="/">
      <EclaireLogo class="logo" />
    </a>
    <div>
      <a href="/">Accueil</a>
      <a href="/calendar">Calendrier</a>
      <!-- <a href="#">Ressources utiles</a> -->
    </div>
  </div>
</header>

<style>
  .navCont {
    width: 100%;
    height: 10vh;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .logo {
    width: auto;
    height: 10vh;
  }
  .logo-min {
    width: auto;
    height: 7vh;
    display: none;
    margin: auto;
    padding: 1.5vh;
  }
  .nav div {
    margin-right: 1vw;
    display: flex;
    gap: 2vw;
  }
  .nav div a {
    color: var(--color-1);
    text-decoration: none;
    font-size: 1.2rem;
  }
  .nav div a:hover {
    color: rgba(var(--color-2), 1);
  }
</style>
