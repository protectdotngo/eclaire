---
import EclaireLogo from "../assets/eclaire.svg";
import EclaireI from "../assets/eclaire-i.svg";
import OpenSideBar from "../assets/layout-sidebar-left-expand.svg";
import CloseSideBar from "../assets/layout-sidebar-left-collapse.svg";

const { showPanelToggle = false, showV1 = false } = Astro.props;
---

<header class="navCont">
  <div class="nav">
    <a href={showV1 ? "/eclaire-v1" : "/"}>
      <EclaireLogo class="logo" />
      <EclaireI class="logo-min" />
    </a>
    <div>
      <button class="hamburger" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      {
        !showV1 && (
          <nav class="menu">
            <a href="/">Accueil</a>
            <a href="/calendrier">Calendrier</a>
            <a href="/sous-le-capot">Sous le capot</a>
            <a href="/eclaire-v1">Eclaire v1</a>
          </nav>
        )
      }
      {
        showV1 && (
          <nav class="menu">
            <a href="/eclaire-v1">Accueil</a>
            <a href="/eclaire-v1#partenaires">Partenaires</a>
            <a href="/eclaire-v1/ressources">Ressources utiles</a>
            <a href="/" class="menu-return">
              Retour au site
            </a>
          </nav>
        )
      }
      {
        showPanelToggle && (
          <>
            <CloseSideBar class="side-bar-btn icon" id="sideBarClose" />
            <OpenSideBar class="side-bar-btn icon none" id="sideBarOpen" />
          </>
        )
      }
    </div>
  </div>
  {
    !showV1 && (
      <nav class="menu-mobile">
        <a href="/">Accueil</a>
        <a href="/calendrier">Calendrier</a>
        <a href="/sous-le-capot">Sous le capot</a>
        <a href="/eclaire-v1">Eclaire v1</a>
      </nav>
    )
  }
  {
    showV1 && (
      <nav class="menu-mobile">
        <a href="/eclaire-v1">Accueil</a>
        <a href="/eclaire-v1#partenaires">Partenaires</a>
        <a href="/eclaire-v1/ressources">Ressources utiles</a>
        <a href="/" class="menu-return">
          Retour au site
        </a>
      </nav>
    )
  }
</header>

<script>
  const btn = document.querySelector(".hamburger") as HTMLButtonElement;
  const menu = document.querySelector(".menu-mobile") as HTMLDivElement;
  const navCont = document.querySelector(".navCont") as HTMLElement;
  const inlineMenu = document.querySelector(".menu") as HTMLElement;
  const navInner = document.querySelector(".nav") as HTMLElement;

  function checkOverflow() {
    if (!navInner || !inlineMenu) return;
    if (window.innerWidth <= 768) {
      navCont.classList.add("nav-compact");
      return;
    }
    const wasCompact = navCont.classList.contains("nav-compact");
    navCont.classList.remove("nav-compact");
    const overflow = navInner.scrollWidth - navInner.clientWidth;
    const shouldBeCompact = wasCompact ? overflow > 10 : overflow > 0;
    navCont.classList.toggle("nav-compact", shouldBeCompact);
  }

  const resizeObserver = new ResizeObserver(() => {
    checkOverflow();
  });
  resizeObserver.observe(navInner);

  window.addEventListener("load", checkOverflow);

  btn.addEventListener("click", () => {
    const isOpen = menu.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(isOpen));
    document.body.classList.toggle("mobile-menu-open", isOpen);
    if (isOpen) {
      requestAnimationFrame(() => {
        const height = menu.scrollHeight + 15;
        document.documentElement.style.setProperty(
          "--mobile-menu-height",
          `${height}px`,
        );
      });
    } else {
      document.documentElement.style.setProperty("--mobile-menu-height", "0px");
    }
  });

  document.addEventListener("click", (e) => {
    if (e.target instanceof Element && !e.target.closest("header")) {
      menu.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
      document.body.classList.remove("mobile-menu-open");
      document.documentElement.style.setProperty("--mobile-menu-height", "0px");
    }
  });
</script>

<style>
  .navCont {
    width: 100%;
    background-color: rgba(var(--bg-color-1), 0.5);
    overflow: hidden;
  }
  .nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .nav div {
    display: flex;
    align-items: center;
  }
  .logo {
    width: auto;
    height: 7vh;
  }
  .logo-min {
    width: auto;
    height: 7vh;
    display: none;
    margin: auto;
    padding: 1.5vh;
  }
  .menu {
    margin-right: 1vw;
    display: flex;
    gap: 1vw;
    align-items: center;
  }
  .menu a,
  .menu-mobile a {
    color: var(--color-1);
    text-decoration: none;
    font-size: 1rem;
    display: block;
    padding: 5px 10px;
    border-radius: 12px;
    background-color: rgba(var(--bg-color-1), 1);
    white-space: nowrap;
    transition:
      background-color 0.2s ease-in-out,
      color 0.2s ease-in-out;
  }
  .menu a:hover,
  .menu-mobile a:hover {
    color: rgba(var(--color-2), 1);
    background-color: rgba(var(--bg-color-2), 1);
  }
  .menu-mobile {
    display: flex;
    max-height: 0;
    flex-direction: column;
    gap: 1vh;
    align-items: center;
    transition: ease-in-out 0.3s;
  }
  .menu .menu-return,
  .menu-mobile .menu-return {
    background-color: rgba(var(--color-1), 1);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .menu .menu-return:hover,
  .menu-mobile .menu-return:hover {
    background-color: rgba(var(--color-1), 0.85);
    color: white;
  }
  .side-bar-btn {
    width: 30px;
    height: 30px;
    cursor: pointer;
    margin-right: 1vw;
  }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-right: 1vw;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 3px;
    border-radius: 5px;
    background: rgba(var(--color-1), 1);
    transition:
      transform 0.3s,
      opacity 0.3s;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  .navCont.nav-compact .hamburger {
    display: flex;
  }
  .navCont.nav-compact .menu {
    display: none;
  }
  .navCont.nav-compact .menu-mobile.open {
    padding-bottom: 1rem;
    max-height: 400px;
  }
  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }
    .menu {
      display: none;
    }
    .menu-mobile.open {
      max-height: 500px;
    }
  }
</style>
