---
import Layout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import CalendarComp from "../components/Calendar.astro";
---

<Layout title="Éclaire - Calendrier des Événements">
  <Nav />
  <div class="calendar-cont">
    <CalendarComp />
  </div>
</Layout>

<style>
  .calendar-cont {
    display: flex;
    flex-direction: column;
    padding: 1vh 5vw 2vh 5vw;
    min-height: 90vh;
    box-sizing: border-box;
  }
</style>
