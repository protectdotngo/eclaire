---
import { desc, sql } from "drizzle-orm";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { getEditableTemplate } from "../lib/chatPrompt";
import { db } from "../lib/dbDrizzle";
import { promptConfigInTest } from "../../drizzle/schema";
import type { PromptVersion } from "../interfaces";

const current = await getEditableTemplate();
let versions: PromptVersion[] = [];
try {
  versions = await db
    .select({
      id: promptConfigInTest.id,
      createdAt: promptConfigInTest.createdAt,
      length: sql<number>`length(${promptConfigInTest.content})`,
    })
    .from(promptConfigInTest)
    .orderBy(desc(promptConfigInTest.createdAt))
    .limit(50);
} catch {
  // Table not found → no history
}
---

<BaseLayout title="Éclaire - Édition du prompt">
  <Nav />
  <main class="prompt-editor">
    <header>
      <h1>Prompt système du chat</h1>
      <p>
        Ce texte est envoyé comme instructions au modèle à chaque question. Les
        modifications s'appliquent immédiatement (sans redéploiement). Le
        placeholder <code>[Insère ici le contenu de l'annuaire en JSON]</code>
        est obligatoire : il est remplacé par l'annuaire des organisations.
      </p>
      <p class="meta">
        Source actuelle:
        <strong
          >{
            current.source === "db"
              ? `modifié (${current.updatedAt ? new Date(current.updatedAt).toLocaleString("fr-CH") : ""})`
              : "défaut (fichier versionné)"
          }</strong
        >
      </p>
    </header>

    <textarea id="prompt-content" spellcheck="false">{current.content}</textarea
    >

    <div class="actions">
      <button id="save-btn" type="button">Enregistrer</button>
      <button id="reset-btn" type="button" class="secondary">
        Rétablir le défaut
      </button>
      <span id="status" role="status"></span>
    </div>

    {
      versions.length > 0 && (
        <section class="history">
          <h2>Historique ({versions.length} versions)</h2>
          <p class="meta">
            « Charger » remplit l'éditeur avec la version choisie — elle ne
            devient active qu'après « Enregistrer ».
          </p>
          <ol>
            {versions.map((v, i) => (
              <li>
                <span class="v-date">
                  {new Date(v.createdAt).toLocaleString("fr-CH")}
                </span>
                <span class="v-len">
                  {v.length.toLocaleString("fr-CH")} car.
                </span>
                {i === 0 ? (
                  <span class="v-active">active</span>
                ) : (
                  <button type="button" class="v-load" data-id={v.id}>
                    Charger
                  </button>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </main>
</BaseLayout>

<script>
  const textarea = document.getElementById(
    "prompt-content",
  ) as HTMLTextAreaElement;
  const saveBtn = document.getElementById("save-btn") as HTMLButtonElement;
  const resetBtn = document.getElementById("reset-btn") as HTMLButtonElement;
  const status = document.getElementById("status") as HTMLSpanElement;

  async function submit(payload: object) {
    saveBtn.disabled = true;
    resetBtn.disabled = true;
    status.textContent = "Enregistrement…";
    status.className = "";
    try {
      const res = await fetch("/api/prompt", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? `Erreur ${res.status}`);
      status.textContent = "Enregistré ✓ — actif immédiatement";
      status.className = "ok";
      if ("reset" in payload) {
        const fresh = await fetch("/api/prompt").then((r) => r.json());
        textarea.value = fresh.content;
      }
    } catch (err) {
      status.textContent =
        err instanceof Error ? err.message : "Échec de la sauvegarde";
      status.className = "error";
    } finally {
      saveBtn.disabled = false;
      resetBtn.disabled = false;
    }
  }

  saveBtn.addEventListener("click", () => submit({ content: textarea.value }));
  resetBtn.addEventListener("click", () => {
    if (confirm("Rétablir le prompt par défaut (fichier versionné) ?")) {
      submit({ reset: true });
    }
  });

  document.querySelectorAll<HTMLButtonElement>(".v-load").forEach((btn) => {
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      try {
        const res = await fetch(`/api/prompt?id=${btn.dataset.id}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? `Erreur ${res.status}`);
        textarea.value = data.content;
        textarea.scrollTop = 0;
        window.scrollTo({ top: 0, behavior: "smooth" });
        status.textContent = `Version du ${new Date(data.createdAt).toLocaleString("fr-CH")} chargée — cliquer « Enregistrer » pour la réactiver`;
        status.className = "";
      } catch (err) {
        status.textContent =
          err instanceof Error ? err.message : "Échec du chargement";
        status.className = "error";
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .prompt-editor {
    max-width: 60rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  header p {
    color: rgb(var(--color-2, 80, 80, 80));
    line-height: 1.5;
  }
  header code {
    background: rgba(0, 0, 0, 0.06);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }
  .meta {
    font-size: 0.9rem;
  }
  #prompt-content {
    width: 100%;
    min-height: 65vh;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.45;
    padding: 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    box-sizing: border-box;
    resize: vertical;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .actions button {
    padding: 0.55rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: rgb(var(--color-1, 0, 0, 0));
    color: rgb(var(--bg-color-1, 255, 255, 255));
    font-weight: 600;
    cursor: pointer;
  }
  .actions button.secondary {
    background: transparent;
    color: rgb(var(--color-1, 0, 0, 0));
    border: 1px solid rgba(0, 0, 0, 0.3);
  }
  .actions button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  #status.ok {
    color: #1a7f37;
  }
  #status.error {
    color: #c62828;
  }
  .history h2 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }
  .history ol {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    max-height: 20rem;
    overflow-y: auto;
  }
  .history li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 0.9rem;
  }
  .history li:last-child {
    border-bottom: none;
  }
  .v-date {
    min-width: 11rem;
  }
  .v-len {
    color: rgb(var(--color-2, 80, 80, 80));
    min-width: 6rem;
  }
  .v-active {
    font-weight: 600;
    color: #1a7f37;
  }
  .v-load {
    padding: 0.2rem 0.7rem;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.3);
    background: transparent;
    cursor: pointer;
  }
  .v-load:disabled {
    opacity: 0.5;
  }
</style>
