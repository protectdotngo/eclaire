---
import MainLayout from "../../layouts/MainLayout.astro";
import Hero from "../../components/sections/general/Hero.astro";
---

<MainLayout title="Merci pour ta proposition" description={""}>
  <Hero
    title="Merci pour ta proposition"
    lead="Nous l'examinerons dans les jours qui viennent. Si nécessaire, nous te recontacterons à l'email que tu as indiqué."
    body="En attendant, tu peux continuer d'explorer l'annuaire."
    image="/images/5.jpg"
  >
    <div class="thanks-actions" slot="intro">
      <a href="/" class="thanks-btn thanks-btn-primary">Retour à l'accueil</a>
      <a href="/calendrier" class="thanks-btn thanks-btn-secondary">
        Voir le calendrier
      </a>
    </div>
  </Hero>
</MainLayout>

<style>
  .thanks-actions {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  :global(.thanks-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk),
      var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
    cursor: pointer;
    text-decoration: none;
    color: white;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .thanks-btn:hover {
    transform: translateY(-1px);
  }

  .thanks-btn-primary {
    background: rgba(var(--color-main), 1);
  }

  .thanks-btn-primary:hover {
    background: rgba(var(--color-main-dark), 1);
  }

  .thanks-btn-secondary {
    background-color: white;
    color: rgba(var(--color-main-2), 1);
    border: 1.5px solid rgba(var(--color-main-2), 0.3);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .thanks-btn-secondary:hover {
    background-color: rgba(var(--color-main-2), 0.05);
    border-color: rgba(var(--color-main-2), 1);
  }
</style>
