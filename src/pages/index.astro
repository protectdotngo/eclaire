---
import Layout from "../layouts/BaseLayout.astro";
import Map from "../components/Map.astro";
import SearchLayout from "../layouts/SearchLayout.astro";
---

<Layout title="Éclaire - Le Phare Numérique">
  <div class="page">
    <SearchLayout />
    <div class="main">
      <Map />
    </div>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: row;
  }
  .main {
    width: 100%;
  }
</style>
