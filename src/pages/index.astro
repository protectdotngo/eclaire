---
import BaseLayout from "../layouts/BaseLayout.astro";
import Map from "../components/Map.astro";
import SidePanel from "../components/SidePanel.astro";
import Main from "../components/sections/general/Main.astro";
---

<BaseLayout title="Le Phare Numérique" description={undefined}>
  <div class="page">
    <SidePanel class="search" />
    <Main class="nav-cont-index">
      <Map />
    </Main>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: row;
  }
  .main {
    width: 100%;
    position: relative;
  }
</style>
