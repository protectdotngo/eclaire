---
import Layout from "../layouts/MapLayout.astro";
import Map from "../components/Map.astro";
import SearchLayout from "../layouts/SearchLayout.astro";
---

<Layout>
  <SearchLayout />
  <div class="main">
    <Map />
  </div>
</Layout>

<style>
  :root {
    --bg-color-1: 255, 255, 255;
    --color-1: 0, 0, 0;
    --color-2: 80, 80, 80;
  }
  html, body {
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    margin: 0;
    width: 100%;
    height: 100%;
  }
  .main{
    width: 100%;
  }
</style>
