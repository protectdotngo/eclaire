---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Vérification des propositions" description={undefined}>
  <div class="verif" x-data="verifPage()" x-init="init()">
    <div>
      <h1>Propositions vérifiées</h1>
      <p>
        Chaque proposition ci-dessous a été contrôlée automatiquement et n'a pas
        été rejetée. Clique sur une carte pour examiner, corriger puis publier.
        Les libellés <span class="lg-green">en vert</span> ont été confirmés par la
        vérification automatique ; ceux <span class="lg-red">en rouge</span> ont été
        signalés comme suspects.
      </p>
    </div>

    <div class="layout" :class="{ 'detail-open': active }">
      <section class="list" aria-label="Liste des propositions">
        <p class="empty" x-show="loading">Chargement…</p>
        <p class="empty" x-show="listError" x-text="listError"></p>
        <p class="empty" x-show="!loading && !listError && items.length === 0">
          Aucune proposition à examiner pour le moment.
        </p>

        <p class="list-count" x-show="items.length > 0">
          <span x-text="items.length"></span>
          <span x-text="items.length > 1 ? ' propositions' : ' proposition'"
          ></span>
        </p>

        <div class="cards">
          <template x-for="(it, i) in items" :key="it.verificationId">
            <div
              class="verif-card"
              :class="{ 'verif-card-alt': i % 2 !== 0, 'active': activeId === it.verificationId }"
              @click="open(it.verificationId)"
            >
              <div class="vc-top">
                <h3 class="vc-title" x-text="it.orgName || '(sans nom)'"></h3>
                <span
                  class="badge"
                  :class="it.action === 'modify' ? 'mod' : 'new'"
                  x-text="it.action === 'modify' ? 'Modification' : 'Nouvelle org'"
                ></span>
              </div>
              <div class="vc-meta">
                <span class="vc-chip">
                  Score :
                  <span
                    x-text="it.legitimacyScore != null ? it.legitimacyScore + '/10' : '—'"
                  ></span>
                </span>
                <span class="vc-chip" x-text="it.verdict || 'verdict n/a'"
                ></span>
              </div>
              <p
                class="vc-sub"
                x-show="it.submitterEmail"
                x-text="it.submitterEmail"
              >
              </p>
              <hr class="vc-separator" />
              <button type="button" class="vc-btn">
                <span>Ouvrir le formulaire</span>
                <span class="vc-arrow">→</span>
              </button>
            </div>
          </template>
        </div>
      </section>

      <section class="detail" x-show="active" x-cloak>
        <template x-if="active">
          <div>
            <div class="detail-head">
              <div>
                <h2 x-text="fieldValues.name || '(sans nom)'"></h2>
                <p class="meta">
                  <span
                    x-text="active.action === 'modify' ? 'Modification d\'une org existante' : 'Nouvelle organisation'"
                  ></span>
                  <br />
                  proposé par:&ensp;
                  <span x-text="active.submitterEmail || '—'"></span>
                  <template x-if="active.adminEditor">
                    <span>
                      · dernière édition :
                      <span x-text="active.adminEditor"></span>
                      <template x-if="active.adminEditedAt">
                        <span
                          x-text="' le ' + new Date(active.adminEditedAt).toLocaleString('fr-CH')"
                        ></span>
                      </template>
                    </span>
                  </template>
                </p>
              </div>
              <button
                type="button"
                class="close"
                aria-label="Fermer"
                @click="close()"
              >
                ✕
              </button>
            </div>

            <div class="verdict-bar">
              <span>
                Verdict automatique :
                <strong x-text="active.verdict || 'n/a'"></strong>
              </span>
              <span>
                Score de légitimité :
                <strong
                  x-text="active.legitimacyScore != null ? active.legitimacyScore + '/10' : '—'"
                ></strong>
              </span>
              <span class="notes" x-show="active.notes" x-text="active.notes"
              ></span>
            </div>

            <div class="form-body">
              <template x-for="f in fieldOrder" :key="f">
                <div class="field">
                  <label :for="'f-' + f">
                    <span
                      class="lbl-text"
                      :class="fieldState(f)"
                      x-text="fieldLabels[f] || f"></span>
                    <button
                      type="button"
                      class="help"
                      x-show="fieldState(f)"
                      :class="fieldState(f)"
                      aria-label="Explication"
                      tabindex="0"
                      @mouseenter="showTip($event, f)"
                      @mouseleave="hideTip()"
                      @focus="showTip($event, f)"
                      @blur="hideTip()"
                    >
                      ?
                    </button>
                  </label>
                  <template x-if="arrayFields.includes(f)">
                    <input
                      type="text"
                      :id="'f-' + f"
                      x-model="fieldValues[f]"
                      placeholder="Valeurs séparées par des virgules"
                    />
                  </template>
                  <template x-if="f === 'desc'">
                    <textarea :id="'f-' + f" rows="4" x-model="fieldValues[f]"
                    ></textarea>
                  </template>
                  <template x-if="!arrayFields.includes(f) && f !== 'desc'">
                    <input
                      type="text"
                      :id="'f-' + f"
                      x-model="fieldValues[f]"
                    />
                  </template>
                </div>
              </template>

              <div class="field admin">
                <label for="f-admin">
                  <span class="lbl-text">Ton email</span>
                </label>
                <input
                  type="email"
                  id="f-admin"
                  x-model="adminEditor"
                  placeholder="exemple@protect.ngo"
                  required
                />
              </div>

              <div class="actions">
                <button
                  type="button"
                  class="secondary"
                  :disabled="busy"
                  @click="submit('save')"
                >
                  Enregistrer
                </button>
                <button
                  type="button"
                  :disabled="busy"
                  @click="submit('publish')"
                >
                  Publier
                </button>
                <button
                  type="button"
                  class="danger"
                  :disabled="busy"
                  @click="submit('reject')"
                >
                  Rejeter
                </button>
                <span :class="statusClass" x-text="status" role="status"></span>
              </div>
            </div>
          </div>
        </template>
      </section>
    </div>

    <div
      class="tooltip"
      role="tooltip"
      x-show="tip.text"
      x-cloak
      :style="`top:${tip.top}px; left:${tip.left}px`"
      x-text="tip.text"
    >
    </div>
  </div>
</MainLayout>

<script>
  import {
    ORG_FIELDS,
    ARRAY_FIELDS,
    type Detail,
    type ListItem,
  } from "../interfaces/verification";
  import Alpine from "alpinejs";

  const FIELD_LABELS: Record<string, string> = {
    name: "Nom",
    desc: "Description",
    categories: "Catégories",
    domain: "Site web",
    address: "Adresse",
    city: "Ville",
    rss: "Flux RSS",
    events_url: "URL des événements",
    news_url: "URL des actualités",
    socials: "Réseaux sociaux",
    contact: "Contact",
  };

  const HELP_GREEN =
    "La vérification automatique n'a rien trouvé de suspect sur ce champ. Il ne devrait pas y avoir de problème à conserver la valeur. Au besoin, une petite recherche de confirmation reste la meilleure option.";
  const HELP_RED =
    "La vérification automatique a signalé ce champ comme suspect. Il est vivement recommandé de vérifier soigneusement cette information avant de publier.";

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.addEventListener("alpine:init", () => {
    Alpine.data("verifPage", () => ({
      items: [] as ListItem[],
      loading: true,
      listError: "",

      active: null as Detail | null,
      activeId: "",
      fieldValues: {} as Record<string, string>,
      adminEditor: "",
      busy: false,
      status: "",
      statusClass: "",

      fieldOrder: ORG_FIELDS as readonly string[],
      arrayFields: ARRAY_FIELDS as readonly string[],
      fieldLabels: FIELD_LABELS,

      tip: { text: "", top: 0, left: 0 },

      async init() {
        try {
          const res = await fetch("/api/verifications");
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? `Erreur ${res.status}`);
          this.items = data.items as ListItem[];
        } catch (err) {
          this.listError =
            err instanceof Error ? err.message : "Échec du chargement";
        } finally {
          this.loading = false;
        }
      },

      async open(id: string) {
        this.activeId = id;
        this.status = "";
        this.statusClass = "";
        try {
          const res = await fetch(
            `/api/verifications?id=${encodeURIComponent(id)}`,
          );
          const data = (await res.json()) as Detail & { error?: string };
          if (!res.ok) throw new Error(data.error ?? `Erreur ${res.status}`);
          this.active = data;
          const fv: Record<string, string> = {};
          for (const f of this.fieldOrder) {
            const val = data.values[f];
            fv[f] = Array.isArray(val) ? val.join(", ") : (val ?? "");
          }
          this.fieldValues = fv;
          if (!this.adminEditor && data.adminEditor)
            this.adminEditor = data.adminEditor;
          this.$nextTick(() => {
            (this.$root as HTMLElement)
              .querySelector(".detail")
              ?.scrollIntoView({ behavior: "smooth", block: "start" });
          });
        } catch (err) {
          this.status =
            err instanceof Error ? err.message : "Échec du chargement";
          this.statusClass = "error";
        }
      },

      close() {
        this.active = null;
        this.activeId = "";
        this.hideTip();
      },

      fieldState(f: string): string {
        if (!this.active) return "";
        if (this.active.suspiciousChanges?.includes(f)) return "red";
        if (this.active.confirmedByWeb?.includes(f)) return "green";
        return "";
      },

      showTip(ev: Event, f: string) {
        const state = this.fieldState(f);
        if (!state) return;
        const el = ev.currentTarget as HTMLElement;
        const r = el.getBoundingClientRect();
        this.tip = {
          text: state === "red" ? HELP_RED : HELP_GREEN,
          top: window.scrollY + r.bottom + 6,
          left: Math.min(
            window.scrollX + r.left,
            window.scrollX + window.innerWidth - 320,
          ),
        };
      },
      hideTip() {
        this.tip = { text: "", top: 0, left: 0 };
      },

      collectFields(): Record<string, string[] | string> {
        const out: Record<string, string[] | string> = {};
        for (const f of this.fieldOrder) {
          const raw = this.fieldValues[f] ?? "";
          if (this.arrayFields.includes(f)) {
            out[f] = raw
              .split(",")
              .map((x) => x.trim())
              .filter(Boolean);
          } else {
            out[f] = raw;
          }
        }
        return out;
      },

      async submit(mode: "save" | "publish" | "reject") {
        if (!this.active) return;
        const email = this.adminEditor.trim();
        if (!EMAIL_RE.test(email)) {
          this.status = "Renseigne un email valide avant de continuer.";
          this.statusClass = "error";
          return;
        }
        if (
          mode === "publish" &&
          !confirm("Publier cette proposition dans la base ?")
        )
          return;
        if (
          mode === "reject" &&
          !confirm("Rejeter cette proposition ? Elle ne sera pas publiée.")
        )
          return;

        this.busy = true;
        this.status =
          mode === "publish"
            ? "Publication…"
            : mode === "reject"
              ? "Rejet…"
              : "Enregistrement…";
        this.statusClass = "";
        try {
          const payload: Record<string, unknown> = {
            verificationId: this.active.verificationId,
            adminEditor: email,
          };
          if (mode === "publish") payload.publish = true;
          if (mode === "reject") payload.reject = true;
          if (mode !== "reject") payload.fields = this.collectFields();

          const res = await fetch("/api/verifications", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? `Erreur ${res.status}`);

          if (mode === "save") {
            this.status = "Enregistré ✓";
            this.statusClass = "ok";
            return;
          }

          this.status =
            mode === "reject"
              ? "Rejeté ✓"
              : data.changed === 0
                ? "Publié ✓ (aucun champ modifié)"
                : "Publié ✓";
          this.statusClass = "ok";
          const doneId = this.active.verificationId;
          setTimeout(() => {
            this.items = this.items.filter(
              (it) => it.verificationId !== doneId,
            );
            this.close();
          }, 900);
        } catch (err) {
          this.status =
            err instanceof Error ? err.message : "Échec de l'opération";
          this.statusClass = "error";
        } finally {
          this.busy = false;
        }
      },
    }));
  });
</script>

<style>
  .verif {
    max-width: 78rem;
    margin: 0 auto;
    padding: 8.5rem 1rem 3rem;
  }
  header p {
    color: rgb(var(--color-2, 80, 80, 80));
    line-height: 1.5;
    max-width: 55rem;
  }
  .lg-green {
    color: #15803d;
    font-weight: 600;
  }
  .lg-red {
    color: #b91c1c;
    font-weight: 600;
  }
  .layout {
    display: grid;
    grid-template-columns: 20rem 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
    align-items: start;
  }
  @media (max-width: 52rem) {
    .layout {
      grid-template-columns: 1fr;
    }
    /* When the form is open on mobile, show it first and push the list below. */
    .layout.detail-open .detail {
      order: 1;
    }
    .layout.detail-open .list {
      order: 2;
    }
  }
  .list .cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .empty {
    font-size: 0.9rem;
    color: rgb(var(--color-2, 100, 100, 100));
  }
  .list-count {
    font-size: 1rem;
    font-weight: 600;
    color: rgba(var(--color-main-2), 1);
    letter-spacing: 0.03em;
    margin: 0 0 0.75rem;
  }
  .verif-card {
    border: 1px solid #e6e6e6;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    background: white;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .verif-card-alt {
    background: rgba(var(--color-main-2), 0.05);
  }
  .verif-card:hover {
    border-color: rgba(var(--color-main-2), 0.5);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }
  .verif-card.active {
    border-color: rgba(var(--color-main-2), 1);
    box-shadow: 0 0 0 1px rgba(var(--color-main-2), 1);
  }
  .vc-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .vc-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: #1f2937;
    margin: 0 0 0.5rem;
    line-height: 1.25;
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk),
      var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .badge.mod {
    background: #fef3c7;
    color: #92400e;
  }
  .badge.new {
    background: #dcfce7;
    color: #166534;
  }
  .vc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .vc-chip {
    font-size: 0.8rem;
    color: #4b5563;
    background: rgba(0, 0, 0, 0.04);
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
  }
  .vc-sub {
    font-size: 0.9rem;
    color: #6b7280;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vc-separator {
    border: none;
    border-top: 1px solid rgba(var(--color-main-2), 0.15);
    margin: 0.85rem 0;
  }
  .vc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    font-size: 0.95rem;
    cursor: pointer;
    border: 1.5px solid rgba(var(--color-main-2), 0.3);
    background: white;
    color: rgba(var(--color-main-2), 1);
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk),
      var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .verif-card:hover .vc-btn,
  .verif-card.active .vc-btn {
    background: rgba(var(--color-main-2), 1);
    border-color: rgba(var(--color-main-2), 1);
    color: white;
  }
  .vc-arrow {
    transition: transform 0.15s ease;
  }
  .verif-card:hover .vc-arrow {
    transform: translateX(3px);
  }
  .detail {
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 12px;
    padding: 1.2rem 1.3rem 1.5rem;
  }
  .detail-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .detail-head h2 {
    margin: 0 0 0.2rem;
  }
  .close {
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    color: rgb(var(--color-2, 90, 90, 90));
    padding: 0.2rem 0.4rem;
  }
  .verdict-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.6rem 0.8rem;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 8px;
    font-size: 0.85rem;
    margin: 0.8rem 0 1.2rem;
  }
  .verdict-bar .notes {
    flex-basis: 100%;
    color: rgb(var(--color-2, 90, 90, 90));
  }
  .field {
    margin-bottom: 1rem;
  }
  .field label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .lbl-text.green {
    color: #15803d;
  }
  .lbl-text.red {
    color: #b91c1c;
  }
  .help {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: none;
    font-size: 0.7rem;
    line-height: 1;
    cursor: help;
    color: rgb(var(--color-2, 120, 120, 120));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .help.green {
    color: #15803d;
  }
  .help.red {
    color: #b91c1c;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    box-sizing: border-box;
    font-size: 0.9rem;
    font-family: inherit;
  }
  .field textarea {
    resize: vertical;
  }
  .field.admin {
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .actions button {
    padding: 0.55rem 1.2rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    background: #2563eb;
    color: #fff;
  }
  .actions button.secondary {
    background: rgba(0, 0, 0, 0.08);
    color: inherit;
  }
  .actions button.danger {
    background: #fff;
    color: #b91c1c;
    border: 1.5px solid rgba(185, 28, 28, 0.4);
  }
  .actions button.danger:hover {
    background: #b91c1c;
    color: #fff;
    border-color: #b91c1c;
  }
  .actions button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .actions [role="status"].ok {
    color: #15803d;
  }
  .actions [role="status"].error {
    color: #b91c1c;
  }
  [x-cloak] {
    display: none !important;
  }
  .tooltip {
    position: absolute;
    z-index: 50;
    max-width: 20rem;
    background: #1f2937;
    color: #fff;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    font-size: 0.8rem;
    line-height: 1.4;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
</style>
