---
import Head from "../components/sections/general/Head.astro";

interface Props {
  title: string;
  description: string[] | string | undefined;
}

const { title, description } = Astro.props;
const pageTitle = title
  ? `${title} | éclaire by Protect.ngo`
  : "éclaire by Protect.ngo";
const metaDescription = Array.isArray(description)
  ? description.join(" ")
  : description;
---

<!doctype html>
<html lang="fr">
  <Head title={pageTitle} description={metaDescription} />
  <body class="side-panel-open">
    <slot />
  </body>
</html>

<style>
  :root {
    --bg-color-1: 255, 255, 255;
    --bg-color-2: 245, 245, 245;
    --color-1: 0, 0, 0;
    --color-2: 80, 80, 80;
    --color-main: 217, 36, 148; /* #d92494 */
    --color-main-dark: 178, 36, 121;
    --color-main-2: 181, 46, 196; /* #b52ec4 */
    --color-main-2-dark: 140, 36, 151;
    --color-main-3: 237, 31, 122; /* #ed1f7a */
    --color-main-3-dark: 194, 26, 101;
    --color-required: 199, 59, 93; /* #c73b5d */
  }
  html,
  body {
    font-family:
      var(--font-neue-haas-grotesk), var(--font-inter-tight),
      var(--font-founders-grotesk), Inter, Roboto, "Helvetica Neue",
      "Arial Nova", "Nimbus Sans", Arial, sans-serif;
    margin: 0;
    width: 100%;
    height: 100%;
    overflow-x: clip;
  }
  /* Sticky footer: the body grows past the viewport when the content is taller,
     and stacks its sections in a column otherwise, so a footer with
     `margin-top: auto` sits at the bottom of the viewport on short pages
     instead of right under the content. */
  body {
    height: auto;
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }
</style>
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  .none {
    display: none !important;
  }
  h1,
  h2,
  h3,
  h4,
  h5 {
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk),
      var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
  }
  input {
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk),
      var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
  }
  /* Sticky footer, second half: the content area takes the leftover space of
     the body column, so short pages end with the footer at the bottom of the
     viewport and no detached white band above it. `body > main` deliberately
     skips the home page, where <Main> sits inside the flex row of .page. */
  body > main {
    flex: 1 0 auto;
  }
  .navContMain {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 5000;
    width: 100%;
  }
</style>
