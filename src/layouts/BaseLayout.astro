---
const { title = "Default Title" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FH1JTNMC8R"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-FH1JTNMC8R");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap");
  @font-face {
    font-family: "FoundersGroteskSemibold";
    src: url("/fonts/FoundersGrotesk-Semibold.otf") format("opentype");
  }

  :root {
    --bg-color-1: 255, 255, 255;
    --bg-color-2: 245, 245, 245;
    --color-1: 0, 0, 0;
    --color-2: 80, 80, 80;
  }
  html,
  body {
    font-family:
      "Inter Tight", Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
    margin: 0;
    width: 100%;
    height: 100%;
    overflow-x: clip;
  }
</style>
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  .none {
    display: none !important;
  }
  h1,
  h2,
  h3,
  h4,
  h5 {
    font-family:
      "FoundersGroteskSemibold", "Inter Tight", Inter, Roboto, "Helvetica Neue",
      "Arial Nova", "Nimbus Sans", Arial, sans-serif;
  }
  input {
    font-family:
      "Inter Tight", Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
  }
</style>
