---
import Head from "../components/sections/general/Head.astro";

const { title = "Eclaire" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <Head title={title} />
  <body class="side-panel-open">
    <slot />
  </body>
</html>

<style>
  :root {
    --bg-color-1: 255, 255, 255;
    --bg-color-2: 245, 245, 245;
    --color-1: 0, 0, 0;
    --color-2: 80, 80, 80;
    --color-main: 217, 36, 148; /* #d92494 */
    --color-main-dark: 178, 36, 121;
    --color-main-2: 181, 46, 196; /* #b52ec4 */
    --color-main-2-dark: 140, 36, 151;
    --color-main-3: 237, 31, 122; /* #ed1f7a */
    --color-main-3-dark: 194, 26, 101;
    --color-required: 199, 59, 93; /* #c73b5d */
  }
  html,
  body {
    font-family:
      var(--font-neue-haas-grotesk), var(--font-inter-tight), var(--font-founders-grotesk), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
    margin: 0;
    width: 100%;
    height: 100%;
    overflow-x: clip;
  }
</style>
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  .none {
    display: none !important;
  }
  h1,
  h2,
  h3,
  h4,
  h5 {
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk), var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
  }
  input {
    font-family:
      var(--font-neue-haas-grotesk), var(--font-founders-grotesk), var(--font-inter-tight), Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
  }
  .navContMain {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 5000;
    width: 100%;
  }
</style>
